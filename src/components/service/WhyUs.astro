---
interface Props { heading: string; intro?: string; items: { heading: string; body: string }[]; }
const { heading, intro, items } = Astro.props;
---
<section class="py-section bg-cream" aria-labelledby="whyus-heading">
  <div class="container-custom">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-fluid-xl">
        <h2 id="whyus-heading" class="font-display text-fluid-2xl md:text-fluid-3xl lg:text-fluid-4xl font-bold text-neutral-dark leading-tight">
          {heading}
        </h2>
        {intro && <p class="text-fluid-body text-neutral-grey mt-fluid-sm leading-relaxed">{intro}</p>}
      </div>
      <ul class="flex flex-col gap-fluid-sm" role="list">
        {items.map((item, i) => (
          <li class="flex gap-fluid-md items-start bg-white rounded-2xl p-fluid-md shadow-sm">
            <span class="shrink-0 size-10 rounded-xl bg-brand-light flex items-center justify-center text-white font-bold text-sm" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3 class="text-fluid-base font-semibold text-neutral-dark mb-1">{item.heading}</h3>
              <p class="text-fluid-card text-neutral-grey leading-relaxed">{item.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
