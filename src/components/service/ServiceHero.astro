---
interface Props {
  eyebrow: string;
  heading: string;
  headingAccent?: string;
  ctaHref?: string;
  ctaLabel?: string;
  lang?: 'es' | 'en';
}

const {
  eyebrow,
  heading,
  headingAccent,
  ctaHref = '/contacto',
  ctaLabel,
  lang = 'es',
} = Astro.props;

const ctaText = ctaLabel ?? (lang === 'es' ? 'Agendar mi cita' : 'Book my appointment');
---

<section class="bg-white pt-10 pb-16 lg:pt-14 lg:pb-24" aria-labelledby="service-h1">
  <div class="container-custom">
    <div class="max-w-3xl">
      <!-- Label -->
      <div class="flex items-center gap-3 mb-6">
        <span class="h-px w-10 bg-brand-light shrink-0" aria-hidden="true"></span>
        <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
          {eyebrow}
        </span>
      </div>

      <h1
        id="service-h1"
        class="font-display text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-neutral-dark leading-[1.1] mb-6"
      >
        {heading}{headingAccent && (
          <>{' '}<em class="not-italic text-brand-light">{headingAccent}</em></>
        )}
      </h1>

      <div class="[&_p]:text-lg [&_p]:text-neutral-grey [&_p]:leading-relaxed [&_p]:mb-4 [&_p]:max-w-2xl [&_p:last-of-type]:mb-10">
        <slot />
      </div>

      <a
        href={ctaHref}
        class="inline-flex items-center gap-2 rounded-full bg-brand-light px-8 py-4 text-base font-semibold text-white hover:bg-brand-dark transition-colors shadow-sm focus-visible:outline-2 focus-visible:outline-brand-light"
      >
        {ctaText}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="size-5"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
            clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
