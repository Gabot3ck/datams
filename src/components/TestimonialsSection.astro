---
import TestimonialCard from './TestimonialCard.astro';

interface Review {
  name: string;
  avatar?: string;     // ruta de imagen; si no hay, se usa la inicial del nombre
  rating: number;      // 1-5
  text: string;
  timeAgo: string;
}

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

// TODO: reemplazar por la URL real de la ficha de Google Business / reseñas.
// Ej: https://search.google.com/local/reviews?placeid=<PLACE_ID>
const REVIEWS_URL =
  "https://www.google.com/search?q=datamultiservices&ie=UTF-8#lrd=0x80c8c3e5c36f0a93:0xa7da2c626285ecf5,1,,,,";

// Reseñas placeholder por idioma — reemplazar por las reales de Google.
// (avatar opcional: ruta de imagen; si se omite, se usa la inicial del nombre.)
const t = {
  es: {
    kicker: "TESTIMONIOS",
    heading: "Lo que dice nuestra comunidad",
    subheading: "Reseñas reales de nuestros clientes",
    ctaMore: "Ver más comentarios en Google",
    starsLabel: (n: number) => `${n} de 5 estrellas`,
    reviews: [
      {
        name: "Alexis L.",
        avatar: "https://lh3.googleusercontent.com/a-/ALV-UjUln-M89bp6c9NYyCnPLIM0liv2YMkz-G9ehcQUonCOTFt7wjVZ=w90-h90-p-rp-mo-br100", // TEMP: imagen de ejemplo
        rating: 5,
        text: "¡Me encanta este sitio! Me hacen los taxes rapidísimo y hacen que todo el proceso sea increíblemente sencillo. Llevo años buscando a alguien en quien confiar, y Data’s Multi Services me ha salvado la vida de verdad. Han hecho que todo fuera muy sencillo y sin estrés. ¡Lo recomiendo encarecidamente!",
        timeAgo: "hace 7 meses",
      },
      {
        name: "Juan G.",
        rating: 5,
        text: "Estoy muy contento con la ayuda que me han prestado. La cuestión de los taxes me abrumaba, sobre todo sabiendo que tenía deudas y que nadie me ofrecía una ayuda adecuada, pero este sitio es excelente.",
        timeAgo: "hace 1 mes",
      },
      {
        name: "Irene C.",
        rating: 5,
        text: "Gracias, David, por tu ayuda con mis impuestos y los de mi familia; eres el mejor.",
        timeAgo: "hace 5 meses",
      },
      {
        name: "Blanca M.",
        avatar:"https://lh3.googleusercontent.com/a-/ALV-UjWundnAWPs_mf2Su2npS5v3gsc7a8K_t_ylyIx2akHrJQnTJfeu=w90-h90-p-rp-mo-br100",
        rating: 5,
        text: "Siempre les encargo la declaración de la renta. Hace poco renové mi permiso de trabajo y estoy muy contenta porque me han ayudado mucho con la declaración. Me explican muy bien las desgravaciones. Recomiendo encarecidamente a Karol y a Anna; son muy buenas atendiendo al cliente.",
        timeAgo: "hace 7 meses",
      },
      {
        name: "Juan J.",
        rating: 5,
        text: "Llevo más de 10 años haciendo la declaración de la renta con David. Es muy bueno y lo recomiendo encarecidamente para la declaración de la renta de empresas. ¡Sí, lo recomiendo encarecidamente!",
        timeAgo: "hace 1 año",
      },
      {
        name: "Elizeth M.",
        avatar: "https://lh3.googleusercontent.com/a-/ALV-UjWOOXL4mZTHedSdS9uC1Nb7VxD7zLWrGmWwyzDrIiNwKQkgY7M0=w90-h90-p-rp-mo-br100",
        rating: 5,
        text: "Me encanta este sitio y la gente que trabaja allí. Ana me ayudó a preparar mi declaración de la renta; me atendió de maravilla y fue muy profesional.",
        timeAgo: "hace 7 meses",
      },

    ] satisfies Review[],
  },
  en: {
    kicker: "TESTIMONIALS",
    heading: "What our community says",
    subheading: "Real reviews from our clients",
    ctaMore: "See more reviews on Google",
    starsLabel: (n: number) => `${n} out of 5 stars`,
    reviews: [
      {
        name: "Alexis L.",
        avatar: "https://lh3.googleusercontent.com/a-/ALV-UjUln-M89bp6c9NYyCnPLIM0liv2YMkz-G9ehcQUonCOTFt7wjVZ=w90-h90-p-rp-mo-br100",
        rating: 5,
        text: "I love this place! They do my taxes so fast and make the whole process incredibly easy. I’ve struggled for years to find someone I trust, and Data’s Multi Services has truly been a lifesaver. They made everything smooth and stress-free. Highly recommend!",
        timeAgo: "7 months ago",
      },
      {
        name: "Juan G.",
        rating: 5,
        text: "I am very happy with their help. My taxes were overwhelming, knowing I had debts and no one was offering good help, but this place is excellent.",
        timeAgo: "1 month ago",
      },
      {
        name: "Irene C.",
        rating: 5,
        text: "Thanks David for helpful with my taxes and mi family taxes ever the best.",
        timeAgo: "5 months ago",
      },
      {
        name: "Blanca M.",
        avatar:"https://lh3.googleusercontent.com/a-/ALV-UjWundnAWPs_mf2Su2npS5v3gsc7a8K_t_ylyIx2akHrJQnTJfeu=w90-h90-p-rp-mo-br100",
        rating: 5,
        text: "I always do my taxes with them. I recently renewed my work permit and I'm happy because they've helped me a lot with my taxes. They explain the credits well. I highly recommend Karol and Anna; they're very good at customer service.",
        timeAgo: "7 months ago",
      },
      {
        name: "Juan J.",
        rating: 5,
        text: "I've done my taxes with David for over 10 years. He's very good and highly recommended for business taxes. Yes, I highly recommend him!",
        timeAgo: "1 year ago",
      },
      {
        name: "Elizeth M.",
        avatar: "https://lh3.googleusercontent.com/a-/ALV-UjWOOXL4mZTHedSdS9uC1Nb7VxD7zLWrGmWwyzDrIiNwKQkgY7M0=w90-h90-p-rp-mo-br100",
        rating: 5,
        text: "I love this place and the people who work there. Ana helped me prepare my taxes; she provided lovely service and was very professional.",
        timeAgo: "7 months ago",
      },
    ] satisfies Review[],
  },
}[lang];

const reviews = t.reviews;
const avatarColors = ["bg-brand", "bg-accent", "bg-brand-light"];

// Dos columnas de 3 cards. La derecha va un poco más abajo para intercalarse.
// El contenedor lleva un difuminado inferior común (.fade-bottom) → las cards
// de abajo de AMBAS columnas se desvanecen en la misma línea horizontal,
// invitando a ver más en Google.
const leftReviews = reviews.slice(0, 3);
const rightReviews = reviews.slice(3, 6);
---

<section class="py-24 bg-background-light" aria-labelledby="testimonials-heading">
  <div class="container-custom">

    <!-- Cabecera -->
    <header class="text-center mb-14" data-reveal>
      <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
        {t.kicker}
      </span>
      <h2
        id="testimonials-heading"
        class="font-display text-4xl md:text-5xl font-bold text-neutral-dark mt-4 mb-4 leading-tight text-balance"
      >
        {t.heading}
      </h2>
      <p class="text-neutral-grey text-lg leading-relaxed max-w-xl mx-auto text-pretty">
        {t.subheading}
      </p>
    </header>

    <!-- Dos columnas (derecha un poco más abajo) con difuminado inferior común -->
    <div class="fade-bottom grid gap-6 md:grid-cols-2 md:gap-x-10 max-w-[880px] mx-auto">
      <ul class="flex flex-col gap-6" role="list">
        {leftReviews.map((review, i) => (
          <TestimonialCard
            {...review}
            starsLabel={t.starsLabel(review.rating)}
            avatarClass={avatarColors[i % avatarColors.length]}
            align="left"
            revealDelay={i + 1}
          />
        ))}
      </ul>

      <ul class="flex flex-col gap-6 md:mt-14" role="list">
        {rightReviews.map((review, i) => (
          <TestimonialCard
            {...review}
            starsLabel={t.starsLabel(review.rating)}
            avatarClass={avatarColors[(i + leftReviews.length) % avatarColors.length]}
            align="right"
            pushDown={i === rightReviews.length - 1}
            revealDelay={i + 2}
          />
        ))}
      </ul>
    </div>

    <!-- Enlace a Google -->
    <div class="mt-8 text-center" data-reveal>
      <a
        href={REVIEWS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-2 text-sm font-semibold text-brand
               transition-colors hover:text-brand-dark
               focus-visible:outline-2 focus-visible:outline-brand-dark"
      >
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1Z" />
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23Z" />
          <path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 0 1 0-4.2V7.06H2.18a11 11 0 0 0 0 9.88l3.66-2.84Z" />
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1a11 11 0 0 0-9.82 6.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38Z" />
        </svg>
        {t.ctaMore}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

  </div>
</section>
