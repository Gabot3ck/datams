---

<header class="sticky top-0 z-50 bg-white">
  <!-- Barra superior: idioma + CTA (z-20 para quedar sobre el nav-overlay) -->
  <div class="relative z-20 border-b border-gray-100">
    <div class="container-custom">
      <div class="flex items-center justify-end gap-3 py-2">
        <!-- Selector de idioma -->
        <div class="relative" id="lang-switcher">
          <button
            id="lang-btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-label={`Idioma actual: ${currentLangLabel}. Cambiar idioma`}
            class="flex items-center gap-1.5 rounded-md px-2 py-1 text-sm font-medium text-neutral-grey hover:bg-gray-100 transition-colors cursor-pointer"
          >
            <img
              src={currentFlag}
              alt=""
              aria-hidden="true"
              width="24"
              height="16"
              class="object-cover"
            />
            <span>{currentLangLabel}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
              fill="currentColor"
              class="size-3.5 transition-transform duration-200"
              id="lang-chevron"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                clip-rule="evenodd"></path>
            </svg>
          </button>

          <div
            id="lang-menu"
            role="listbox"
            aria-label="Seleccionar idioma"
            class="absolute z-50 right-0 top-full mt-1 hidden min-w-[6rem] rounded-lg border border-gray-100 bg-white py-1 shadow-lg"
          >
            <a
              href={altLangUrl}
              role="option"
              aria-selected="false"
              class="flex items-center gap-2 px-3 py-2 text-sm text-neutral-grey hover:bg-gray-50 hover:text-brand-light transition-colors"
            >
              <img
                src={altLangFlag}
                alt=""
                aria-hidden="true"
                width="24"
                height="16"
                class="object-cover"
              />
              <span>{altLangLabel}</span>
            </a>
          </div>
        </div>

        <!-- CTA principal -->
        <a
          href={ctaHref}
          class="rounded-full bg-brand-light px-4 py-1.5 text-sm font-medium text-white transition-colors hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-brand-light"
        >
          {cta}
        </a>
      </div>
    </div>
  </div>

  <!-- Barra de navegación principal -->
  <nav
    aria-label={lang === "es" ? "Navegación principal" : "Main navigation"}
    class="relative bg-white shadow-sm"
  >
    <!-- Overlay que cubre los enlaces cuando el selector de idioma está abierto -->
    <div
      id="nav-overlay"
      class="absolute inset-0 z-10 bg-black/55 opacity-0 pointer-events-none transition-opacity duration-200"
      aria-hidden="true"
    ></div>
    <div class="container-custom">
      <div class="flex h-16 items-center justify-between gap-6">
        <!-- Logo -->
        <a
          href={logoHref}
          aria-label={lang === "es"
            ? "Inicio — Tax & Notaría"
            : "Home — Tax & Notary"}
          class="flex shrink-0 items-baseline gap-1 font-bold"
        >
          <span class="text-xl text-brand-light">DATA'S</span>
          <span class="text-xs font-normal text-neutral-grey">&amp;</span>
          <span class="text-xl text-brand-dark">MULTISERVICES</span>
        </a>

        <!-- Navegación desktop -->
        <ul class="hidden items-center gap-1 lg:flex" role="list">
          {
            items.map((item) => (
              <li class="relative">
                {item.megaMenu ? (
                  <MegaMenu
                    client:load
                    label={item.label}
                    subcategories={item.megaMenu}
                    lang={lang}
                    pillarUrl={item.href !== '#' ? item.href : undefined}
                    categoryLabel={item.label}
                    miniLinks={item.miniLinks}
                  />
                ) : (
                  <a
                    href={item.href}
                    class="block rounded-md px-3 py-2 text-sm font-medium text-neutral-grey transition-colors hover:cursor-pointer hover:text-brand-light"
                  >
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>

        <!-- Botón hamburguesa (mobile) -->
        <button
          id="mobile-menu-btn"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label={mobileMenuLabel}
          class="flex size-10 items-center justify-center rounded-md text-neutral-grey hover:bg-gray-100 lg:hidden"
        >
          <svg
            id="icon-open"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
          <svg
            id="icon-close"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="hidden size-6"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Menú mobile -->
    <div
      id="mobile-menu"
      class="hidden border-t border-gray-100 bg-white lg:hidden"
      aria-label={lang === "es" ? "Menú móvil" : "Mobile menu"}
    >
      <ul class="divide-y divide-gray-100 px-4 py-2" role="list">
        {
          items.map((item) => (
            <li>
              {item.megaMenu ? (
                <details class="group/mega">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 text-sm font-semibold text-neutral-dark">
                    {item.label}
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="size-4 transition-transform duration-200 group-open/mega:rotate-180"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </summary>
                  <div class="bg-background-light rounded-lg mb-2">
                    {item.megaMenu.map((sub) => (
                      <details class="group/sub border-b border-gray-200 last:border-0">
                        <summary class="flex cursor-pointer list-none items-center justify-between px-4 py-3 text-sm text-neutral-grey">
                          {sub.label}
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            class="size-4 transition-transform duration-200 group-open/sub:rotate-45"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 4.5v15m7.5-7.5h-15"
                            />
                          </svg>
                        </summary>
                        <ul class="pb-2 px-4" role="list">
                          {sub.items.map((subItem) => (
                            <li>
                              <a
                                href={subItem.href}
                                class="block py-2 text-sm text-neutral-grey hover:text-brand-light transition-colors pl-2 border-l-2 border-gray-200 hover:border-brand-light"
                              >
                                {subItem.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </details>
                    ))}
                    {/* Pillar link — categorías con página propia */}
                    {item.href !== '#' && (
                      <a
                        href={item.href}
                        class="flex items-center gap-1.5 px-4 py-3 text-sm text-brand-light border-t border-gray-200 underline"
                      >
                        {lang === 'es'
                          ? `Ver todos los servicios de ${item.label}`
                          : `See all services in ${item.label}`
                        }
                        <span aria-hidden="true">→</span>
                      </a>
                    )}
                    {/* Mini-links de "Más Servicios" / "More Services" */}
                    {item.miniLinks && item.miniLinks.length > 0 && (
                      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 text-sm font-semibold border-t border-gray-200">
                        {item.miniLinks.map((link, i) => (
                          <>
                            {i > 0 && <span class="text-neutral-grey" aria-hidden="true">·</span>}
                            <a href={link.href} class="text-brand-light hover:underline">{link.label}</a>
                          </>
                        ))}
                      </div>
                    )}
                  </div>
                </details>
              ) : (
                <a
                  href={item.href}
                  class="block py-3 text-sm font-medium text-neutral-grey hover:text-brand-light transition-colors"
                >
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <!-- CTA mobile -->
      <div class="px-4 pb-4 pt-2">
        <a
          href={ctaHref}
          class="block w-full rounded-full bg-brand-light py-3 text-center text-sm font-medium text-white hover:bg-brand-dark transition-colors"
        >
          {cta}
        </a>
      </div>
    </div>
  </nav>
</header>

<!-- Backdrop del selector de idioma -->
<div
  id="lang-backdrop"
  class="fixed inset-0 z-40 bg-black/30 opacity-0 pointer-events-none transition-opacity duration-200"
  aria-hidden="true"
></div>

<script>
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  mobileBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    mobileBtn.setAttribute("aria-expanded", String(isOpen));
    iconOpen?.classList.toggle("hidden", isOpen);
    iconClose?.classList.toggle("hidden", !isOpen);
  });

  const langBtn = document.getElementById("lang-btn");
  const langMenu = document.getElementById("lang-menu");
  const langChevron = document.getElementById("lang-chevron");
  const langBackdrop = document.getElementById("lang-backdrop");
  const navOverlay = document.getElementById("nav-overlay");

  function openLang() {
    langMenu?.classList.remove("hidden");
    langBackdrop?.classList.remove("opacity-0", "pointer-events-none");
    langBackdrop?.classList.add("opacity-100");
    navOverlay?.classList.remove("opacity-0", "pointer-events-none");
    navOverlay?.classList.add("opacity-100");
    langBtn?.setAttribute("aria-expanded", "true");
    langChevron?.classList.add("rotate-180");
  }

  function closeLang() {
    langMenu?.classList.add("hidden");
    langBackdrop?.classList.add("opacity-0", "pointer-events-none");
    langBackdrop?.classList.remove("opacity-100");
    navOverlay?.classList.add("opacity-0", "pointer-events-none");
    navOverlay?.classList.remove("opacity-100");
    langBtn?.setAttribute("aria-expanded", "false");
    langChevron?.classList.remove("rotate-180");
  }

  langBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    langMenu?.classList.contains("hidden") ? openLang() : closeLang();
  });

  langBackdrop?.addEventListener("click", closeLang);

  document.addEventListener("click", (e) => {
    if (!document.getElementById("lang-switcher")?.contains(e.target as Node)) {
      closeLang();
    }
  });
</script>
