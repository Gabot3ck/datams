---
import { BUSINESS } from '../config/site';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

const t = {
  es: {
    eyebrow: "Da el primer paso",
    heading: "¿Listo para resolver tu situación fiscal?",
    subheading: "Llámanos o ven a nuestra oficina en Las Vegas, sin cita. Te ayudamos con tus taxes, trámites de notary public y de tu negocio.",
    callLabel: `Llámanos al ${BUSINESS.phoneDisplay}`,
    imageAlt: "Asesor de Data's & Multiservices atendiendo a un cliente",
  },
  en: {
    eyebrow: "Take the first step",
    heading: "Ready to resolve your tax situation?",
    subheading: "Call us or stop by our Las Vegas office, no appointment needed. We help with your taxes, notary public services, and business paperwork.",
    callLabel: `Call us at ${BUSINESS.phoneDisplay}`,
    imageAlt: "A Data's & Multiservices advisor helping a client",
  },
}[lang];

const telHref = `tel:${BUSINESS.phone}`;
---

<section class="bg-background-light py-section" aria-labelledby="cta-heading">
  <div class="container-custom">
    <div class="grid overflow-hidden rounded-[2.5rem] bg-brand shadow-xl lg:grid-cols-2" data-reveal>

      <!-- Imagen (placeholder — reemplazar por la definitiva) -->
      <div class="relative aspect-[4/3] sm:aspect-[16/9] lg:aspect-auto">
        <img
          src="/assets/images/contacta-datamultiservices.webp"
          alt={t.imageAlt}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover object-[35%_50%] lg:object-center"
        />
      </div>


      <!-- Texto + botón -->
      <div class="flex flex-col justify-center p-fluid-lg lg:px-fluid-xl">
        <span class="text-xs font-bold uppercase tracking-widest text-white/60">
          {t.eyebrow}
        </span>
        <h2
          id="cta-heading"
          class="font-display mt-fluid-xs mb-fluid-sm text-fluid-2xl md:text-fluid-3xl font-bold leading-tight text-white text-balance"
        >
          {t.heading}
        </h2>
        <p class="max-w-md text-fluid-body leading-relaxed text-white/80">
          {t.subheading}
        </p>
        <a
          href={telHref}
          aria-label={t.callLabel}
          class="group mt-fluid-md inline-flex min-h-11 w-fit items-center gap-2 rounded-full bg-white
                 px-fluid-md py-fluid-sm text-sm font-semibold text-brand shadow-lg tabular-nums
                 transition duration-300 hover:text-brand-dark hover:shadow-xl
                 focus-visible:outline-2 focus-visible:outline-white"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
            <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.15c.71 0 1.33.5 1.47 1.2l.7 3.5a1.5 1.5 0 0 1-.8 1.63l-.9.45a10.05 10.05 0 0 0 6.1 6.1l.45-.9a1.5 1.5 0 0 1 1.63-.8l3.5.7c.7.14 1.2.76 1.2 1.47v1.15A1.5 1.5 0 0 1 16.5 18H15C8.1 18 2 11.9 2 5V3.5Z" clip-rule="evenodd" />
          </svg>
          <span class="relative">
            {BUSINESS.phoneDisplay}
            <span
              class="absolute inset-x-0 -bottom-1 h-0.5 origin-left scale-x-0 bg-current
                     transition-transform duration-300 group-hover:scale-x-100 motion-reduce:transition-none"
              aria-hidden="true"
            ></span>
          </span>
        </a>
      </div>



    </div>
  </div>
</section>
