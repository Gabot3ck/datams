---
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'es';
const year = new Date().getFullYear();

// Enlace a la ficha en Google Maps (dirección de la oficina).
const MAPS_URL =
  'https://www.google.com/maps/search/?api=1&query=235%20N%20Eastern%20Ave%20Suite%20130%2C%20Las%20Vegas%2C%20NV%2089101';

// TODO: reemplazar por las URLs reales.
const SOCIAL = {
  instagram: '#',
  facebook: '#',
};
const DEV_URL = '#'; // TODO: enlace de Gabriel Castillo

const t = {
  es: {
    tagline:
      'Taxes · Notaría · Inmigración · Servicios Corporativos para la comunidad hispana en Las Vegas.',
    services: {
      heading: 'Servicios',
      items: [
        { label: 'Taxes', href: '/taxes' },
        { label: 'ITIN / EIN', href: '/itin-ein' },
        { label: 'Notaría Pública', href: '/notaria' },
        { label: 'Inmigración', href: '/inmigracion' },
        { label: 'Negocio', href: '/negocio' },
        { label: 'DMV', href: '/dmv' },
        { label: 'Formularios Corte', href: '/corte' },
        { label: 'Otros Servicios', href: '/otros' },
      ],
    },
    company: {
      heading: 'Empresa',
      items: [
        { label: 'Nosotros', href: '/nosotros' },
        { label: 'Contacto', href: '/contacto' },
      ],
    },
    contact: {
      heading: 'Contacto',
      phone: '(702) 640-0088',
      address: '235 N Eastern Ave. Suite 130, Las Vegas, NV 89101',
      hours: 'Lun–Sáb 9AM–9PM · Dom 10AM–5PM',
      mapsLabel: 'Ver en Google Maps',
    },
    follow: 'Síguenos en:',
    rights: `© ${year} Data's & Multiservices. Todos los derechos reservados.`,
    devBy: 'Desarrollado por Gabriel Castillo',
    logoHref: '/',
    logoAria: 'Inicio',
  },
  en: {
    tagline:
      'Taxes · Notary · Immigration · Business Services for the Hispanic community in Las Vegas.',
    services: {
      heading: 'Services',
      items: [
        { label: 'Taxes', href: '/en/taxes' },
        { label: 'ITIN / EIN', href: '/en/itin-ein' },
        { label: 'Notary Public', href: '/en/notary' },
        { label: 'Immigration', href: '/en/immigration' },
        { label: 'Business', href: '/en/business' },
        { label: 'DMV', href: '/en/dmv' },
        { label: 'Court Forms', href: '/en/court' },
        { label: 'Other Services', href: '/en/other' },
      ],
    },
    company: {
      heading: 'Company',
      items: [
        { label: 'About Us', href: '/en/about' },
        { label: 'Contact', href: '/en/contact' },
      ],
    },
    contact: {
      heading: 'Contact',
      phone: '(702) 640-0088',
      address: '235 N Eastern Ave. Suite 130, Las Vegas, NV 89101',
      hours: 'Mon–Sat 9AM–9PM · Sun 10AM–5PM',
      mapsLabel: 'View on Google Maps',
    },
    follow: 'Follow us:',
    rights: `© ${year} Data's & Multiservices. All rights reserved.`,
    devBy: 'Built by Gabriel Castillo',
    logoHref: '/en',
    logoAria: 'Home',
  },
}[lang];

const telHref = `tel:+1${t.contact.phone.replace(/\D/g, '')}`;
---

<footer class="border-t border-background-muted bg-background-light text-neutral-grey">
  <!-- Grid principal -->
  <div class="container-custom py-14 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">

      <!-- Marca -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={t.logoHref} aria-label={t.logoAria} class="inline-block">
          {/* TODO: reemplazar por el logo real, p. ej. /assets/logo.svg */}
          <img
            src="/assets/images/test/thumb_empresas_4b46959dd7.avif"
            alt="Data's & Multiservices"
            width="140"
            height="40"
            class="h-10 w-auto rounded"
          />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed">{t.tagline}</p>
      </div>

      <!-- Servicios -->
      <nav aria-label={t.services.heading}>
        <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-neutral-dark">
          {t.services.heading}
        </h2>
        <ul class="space-y-2.5" role="list">
          {t.services.items.map((item) => (
            <li>
              <a href={item.href} class="text-sm transition-colors hover:text-brand">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Empresa -->
      <nav aria-label={t.company.heading}>
        <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-neutral-dark">
          {t.company.heading}
        </h2>
        <ul class="space-y-2.5" role="list">
          {t.company.items.map((item) => (
            <li>
              <a href={item.href} class="text-sm transition-colors hover:text-brand">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Contacto -->
      <address class="not-italic">
        <h2 class="mb-4 text-xs font-bold uppercase tracking-widest text-neutral-dark">
          {t.contact.heading}
        </h2>
        <ul class="space-y-3 text-sm" role="list">
          <li class="leading-relaxed">{t.contact.hours}</li>
          <li class="leading-relaxed">{t.contact.address}</li>
          <li>
            <a href={telHref} class="transition-colors hover:text-brand">
              {t.contact.phone}
            </a>
          </li>
          <li>
            <a
              href={MAPS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-semibold text-brand transition-colors hover:text-brand-dark"
            >
              {t.contact.mapsLabel}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
              </svg>
            </a>
          </li>
        </ul>
      </address>

    </div>
  </div>

  <!-- Barra inferior -->
  <div class="border-t border-background-muted">
    <div class="container-custom flex flex-col gap-4 py-5 text-xs text-neutral-grey sm:flex-row sm:items-center sm:justify-between">
      <p>
        {t.rights}
        <span class="mx-1.5 text-neutral-grey/50" aria-hidden="true">·</span>
        <a
          href={DEV_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium transition-colors hover:text-brand hover:underline"
        >
          {t.devBy}
        </a>
      </p>

      <div class="flex items-center gap-3">
        <span>{t.follow}</span>
        <a
          href={SOCIAL.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="text-neutral-grey transition-colors hover:text-brand"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
            <path d="M12 2.2c3.2 0 3.58 0 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58 0-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s0-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5.01-4.74.07-.9.04-1.38.19-1.7.32-.43.16-.73.36-1.06.68-.32.33-.52.63-.68 1.06-.13.32-.28.8-.32 1.7-.06 1.24-.07 1.59-.07 4.74s.01 3.5.07 4.74c.04.9.19 1.38.32 1.7.16.43.36.73.68 1.06.33.32.63.52 1.06.68.32.13.8.28 1.7.32 1.24.06 1.59.07 4.74.07s3.5-.01 4.74-.07c.9-.04 1.38-.19 1.7-.32.43-.16.73-.36 1.06-.68.32-.33.52-.63.68-1.06.13-.32.28-.8.32-1.7.06-1.24.07-1.59.07-4.74s-.01-3.5-.07-4.74c-.04-.9-.19-1.38-.32-1.7a2.85 2.85 0 0 0-.68-1.06 2.85 2.85 0 0 0-1.06-.68c-.32-.13-.8-.28-1.7-.32C15.5 4.01 15.15 4 12 4Zm0 3.06a4.94 4.94 0 1 1 0 9.88 4.94 4.94 0 0 1 0-9.88Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.1-2.14a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z" />
          </svg>
        </a>
        <a
          href={SOCIAL.facebook}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="text-neutral-grey transition-colors hover:text-brand"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
            <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.89 3.78-3.89 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
