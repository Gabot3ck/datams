---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

import s1m from '../assets/images/banners/datamultiservices-taxes-nevada-1m.webp';
import s1t from '../assets/images/banners/datamultiservices-taxes-nevada-1t2.webp';
import s1d from '../assets/images/banners/datamultiservices-taxes-nevada-1d.webp';

import s2m from '../assets/images/banners/slide_tax_1_d.png';
import s2t from '../assets/images/banners/slide_tax_1_d.png';
import s2d from '../assets/images/banners/slide_tax_2_d.png';

import s3m from '../assets/images/banners/slide_tax_3_d.png';
import s3t from '../assets/images/banners/slide_tax_3_d.png';
import s3d from '../assets/images/banners/slide_tax_3_d.png';

// Slide 4 provisorio: reutiliza la imagen de prueba del slide 2 hasta tener la propia
import s4m from '../assets/images/banners/slide_tax_2_d.png';
import s4t from '../assets/images/banners/slide_tax_2_d.png';
import s4d from '../assets/images/banners/slide_tax_2_d.png';

interface Props {
  lang?: 'es' | 'en';
  autoplay?: boolean;
  interval?: number;
  ClassSection?: string;
  classSection?: string;
  id?: string;
}

type SlideContent = {
  title: string;
  subtitle: string;
  placement: 'left' | 'right';
  ctaText?: string;
  ctaHref?: string;
  alt?: string;
  btnClass?: string;
};

type SlideImage = {
  mobile: ImageMetadata;
  tablet: ImageMetadata;
  desktop: ImageMetadata;
  mobilePosition?: string;  // clase object-position del encuadre mobile
  tabletPosition?: string;  // clase object-position del encuadre tablet
  desktopPosition?: string; // clase object-position del encuadre desktop
};

const {
  lang = 'es',
  autoplay = true,
  interval = 6500,
  ClassSection,
  classSection,
  id,
} = Astro.props;

// ≥1440px: proporción fija 2.75:1 en vez de 70vh (en pantallas grandes el hero quedaba muy alto)
const sectionClass = ClassSection ?? classSection ?? "min-h-[500px] sm:min-h-[400px] md:min-h-[500px] xl:min-h-[70vh] min-[1440px]:min-h-0 min-[1440px]:aspect-[2.75/1]";
const uid = id ?? `hero-${Math.random().toString(36).slice(2)}`;

// sm–lg: la caja va de 80px hasta la mitad del ancho (50%).
// lg+: la caja va desde el borde del contenido (columna del logo, mínimo 80px por las
// flechas) hasta la línea áurea (61.8% desde el lado opuesto). Replica el ancho de
// .container-custom: max-w-7xl + xl:px-12 hasta 1520px; luego 80dvw con tope 1920px.
const gridMap: Record<SlideContent['placement'], string> = {
  left:  "sm:left-20 sm:right-[50%] lg:right-[61.8%] xl:left-[max(80px,calc((100%_-_1280px)/2_+_48px))] min-[1520px]:left-[calc((100%_-_min(80dvw,1920px))/2_+_48px)]",
  right: "sm:right-20 sm:left-[50%] lg:left-[61.8%] xl:right-[max(80px,calc((100%_-_1280px)/2_+_48px))] min-[1520px]:right-[calc((100%_-_min(80dvw,1920px))/2_+_48px)]",
};

// Cada slide apunta a una keyword (ver DECISIONES-NEGOCIO.md §5.3). El título del
// slide 1 es el único <h1> del home: lleva "taxes en Las Vegas".
// EN: los CTA apuntan a la página ES mientras su gemela EN no exista (enBuilt: false).
const slidesContent: Record<'es' | 'en', SlideContent[]> = {
  es: [
    {
      title: "Taxes en Las Vegas, con atención en español",
      subtitle: "Declaración personal o de negocio con preparadores registrados (PTIN). Ven sin cita a nuestra oficina.",
      placement: "left",
      ctaText: "Ver servicios de taxes",
      ctaHref: "/taxes/",
      alt: "Asesor de taxes atendiendo a una clienta en su escritorio, en la oficina de Data's & Multiservices en Las Vegas",
    },
    {
      title: "Ayuda con el IRS, en español",
      subtitle: "¿Te llegó una carta del IRS? Te ayudamos a entenderla y a preparar tu respuesta, paso a paso.",
      placement: "right",
      ctaText: "Ver ayuda con el IRS",
      ctaHref: "/irs/",
      alt: "Asesor revisando con una clienta una carta del IRS sobre el escritorio",
      btnClass: "bg-background-light text-brand-dark",
    },
    {
      title: "Notary Public en español, en Las Vegas",
      subtitle: "Firmas ante Notary Public para poderes y otros documentos. Atención por orden de llegada.",
      placement: "left",
      ctaText: "Visítanos hoy",
      ctaHref: "/contacto",
      alt: "Persona firmando un documento ante un Notary Public en el mostrador de la oficina",
    },
    {
      title: "Tu ITIN o EIN, con ayuda en español",
      subtitle: "Te ayudamos a preparar tu solicitud de ITIN o EIN y los taxes de tu LLC o negocio.",
      placement: "right",
      ctaText: "Ver ITIN y EIN",
      ctaHref: "/itin-ein/",
      alt: "Dueña de un pequeño negocio revisando con su asesor formularios de ITIN o EIN en una laptop",
    },
  ],
  en: [
    {
      title: "Las Vegas Tax Preparation, in English & Spanish",
      subtitle: "Personal and business returns from PTIN-registered preparers. Walk-ins welcome at our office.",
      placement: "left",
      ctaText: "See Tax Services",
      ctaHref: "/taxes/",
      alt: "Tax preparer assisting a client at his desk in the Data's & Multiservices office in Las Vegas",
    },
    {
      title: "Help With IRS Letters and Notices",
      subtitle: "Got a letter from the IRS? We help you understand it and prepare your response, step by step.",
      placement: "right",
      ctaText: "Get IRS Help",
      ctaHref: "/irs/",
      alt: "Preparer reviewing an IRS letter on the desk with a client",
      btnClass: "bg-background-light text-brand-dark",
    },
    {
      title: "Notary Public in Las Vegas, Walk-ins Welcome",
      subtitle: "Signatures before a notary public for powers of attorney and other documents.",
      placement: "left",
      ctaText: "Visit Us Today",
      ctaHref: "/contacto",
      alt: "Person signing a document in front of a notary public at the office counter",
    },
    {
      title: "ITIN and EIN Help for Individuals and LLCs",
      subtitle: "We help you prepare your ITIN or EIN application and your LLC or small business taxes.",
      placement: "right",
      ctaText: "ITIN & EIN Services",
      ctaHref: "/itin-ein/",
      alt: "Small business owner reviewing ITIN or EIN forms on a laptop with her advisor",
    },
  ],
};

const ui = {
  es: {
    prevLabel: "Slide anterior",
    nextLabel: "Slide siguiente",
    dotLabel: (i: number) => `Ir al slide ${i + 1}`,
    dotsLabel: "Navegación del slider",
  },
  en: {
    prevLabel: "Previous slide",
    nextLabel: "Next slide",
    dotLabel: (i: number) => `Go to slide ${i + 1}`,
    dotsLabel: "Slider navigation",
  },
}[lang];

const slideImages: SlideImage[] = [
  { mobile: s1m, tablet: s1t, desktop: s1d, mobilePosition: "object-[50%_70%]", tabletPosition: "object-[72%_37%]", desktopPosition: "object-[40%_37%]" },
  { mobile: s2m, tablet: s2t, desktop: s2d },
  { mobile: s3m, tablet: s3t, desktop: s3d },
  { mobile: s4m, tablet: s4t, desktop: s4d },
];

const W_MOBILE = [375, 480, 540, 640, 720, 900];
const W_TABLET = [768, 990, 1200, 1280];
const W_DESKTOP = [1280, 1530, 1920, 2560];

const content = slidesContent[lang];

const slides = await Promise.all(
  slideImages.map(async (imgs, i) => {
    const [m, t, d] = await Promise.all([
      getImage({ src: imgs.mobile, format: "webp", quality: 80, widths: W_MOBILE, sizes: "100vw" }),
      getImage({ src: imgs.tablet, format: "webp", quality: 80, widths: W_TABLET, sizes: "100vw" }),
      getImage({ src: imgs.desktop, format: "webp", quality: 80, widths: W_DESKTOP, sizes: "100vw" }),
    ]);
    return { ...content[i], img: { m, t, d },
      mobilePosition: imgs.mobilePosition ?? "object-center",
      tabletPosition: imgs.tabletPosition ?? "object-center",
      desktopPosition: imgs.desktopPosition ?? "object-center",
    };
  })
);
---

<section
  id={uid}
  data-hero
  data-autoplay={autoplay ? "true" : "false"}
  data-interval={String(interval)}
  tabindex={slides.length > 1 ? 0 : undefined}
  class:list={[
    "group relative isolate w-full overflow-hidden",
    "flex items-stretch",
    "touch-pan-y select-none",
    sectionClass,
  ]}
>
  <!-- Slides -->
  <div class="absolute inset-0" aria-hidden="true">
    {slides.map((s, i) => (
      <div
        class:list={[
          "absolute inset-0 h-full w-full",
          "transition-opacity duration-700 ease-in-out",
          i === 0 ? "opacity-100" : "opacity-0",
        ]}
        data-hero-slide
        data-index={i}
      >
        <!-- MOBILE (<640) -->
        <img
          class:list={["h-full w-full object-cover sm:hidden", s.mobilePosition]}
          src={s.img.m.src}
          srcset={s.img.m.srcSet.attribute}
          sizes="100vw"
          alt={s.alt ?? "Banner"}
          loading={i === 0 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={i === 0 ? "high" : undefined}
        />

        <!-- TABLET (640–989) -->
        <img
          class:list={["hidden h-full w-full object-cover sm:block lg:hidden", s.tabletPosition]}
          src={s.img.t.src}
          srcset={s.img.t.srcSet.attribute}
          sizes="100vw"
          alt={s.alt ?? "Banner"}
          loading={i === 0 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={i === 0 ? "high" : undefined}
        />

        <!-- DESKTOP (>=990) -->
        <img
          class:list={["hidden h-full w-full object-cover lg:block", s.desktopPosition]}
          src={s.img.d.src}
          srcset={s.img.d.srcSet.attribute}
          sizes="100vw"
          alt={s.alt ?? "Banner"}
          loading={i === 0 ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={i === 0 ? "high" : undefined}
        />

        <!-- Degradado de legibilidad: mobile de arriba hacia abajo (texto arriba); lateral según placement desde sm -->
        <div
          class:list={[
            "pointer-events-none absolute inset-0",
            "bg-linear-to-b from-black/85 via-black/55 via-35% to-transparent to-60%",
            s.placement === "left" ? "sm:bg-linear-to-r" : "sm:bg-linear-to-l",
            "sm:from-black/75 sm:via-black/50 sm:via-50% sm:to-transparent sm:to-65% lg:via-40% lg:to-55%",
          ]}
        ></div>
      </div>
    ))}
  </div>

  <!-- Paneles -->
  <div class="relative z-10 w-full">
    <div class="container-custom h-full px-6">
      {slides.map((s, i) => {
        // Un solo <h1> por página: el título del slide 1; los demás son <p> con el mismo estilo
        const Title = i === 0 ? "h1" : "p";
        return (
        <div
          class:list={[
            // mobile: arriba y centrada; sm+: centrada en vertical
            "left-1/2 -translate-x-1/2 top-8 sm:top-1/2 sm:-translate-y-1/2",
            "sm:translate-x-0",
            gridMap[s.placement],
            "hero-panel w-[calc(100%_-_3rem)] max-w-[360px] sm:w-auto sm:max-w-none lg:max-w-[650px] absolute ",
            "text-center sm:text-left",
            "transition-opacity duration-500 ease-in-out",
            i === 0 ? "opacity-100" : "opacity-0 pointer-events-none",
          ]}
          data-hero-panel
          data-index={i}
        >
          <Title
            class="font-bold leading-tight text-balance text-white text-[length:clamp(1.125rem,0.794rem_+_1.47vw,1.75rem)] lg:text-[length:clamp(1.25rem,1.11rem_+_1.3vw,3.2rem)]"
            data-hero-title
          >
            {s.title}
          </Title>

          <p
            class="mt-fluid-sm lg:max-w-[36ch] text-[length:clamp(0.8125rem,0.72rem_+_0.39vw,1rem)] lg:text-[length:clamp(0.875rem,0.75rem_+_0.39vw,1.375rem)] text-white/90"
            data-hero-subtitle
          >
            {s.subtitle}
          </p>

          {s.ctaHref && s.ctaText && (
            <div
              class="mt-fluid-md flex flex-wrap items-center gap-4"
              data-hero-cta
            >
              <a
                href={s.ctaHref}
                class={` ${s.btnClass || "bg-brand hover:bg-brand-dark text-background-light"} inline-flex min-h-11 items-center text-xs px-[1.4em] py-[0.7em] sm:text-[length:clamp(0.8125rem,0.74rem_+_0.3vw,1.0625rem)] sm:px-[1.8em] sm:py-[0.9em] mx-auto sm:mx-0 rounded-md transition-colors ease-in duration-300`}
              >
                {s.ctaText}
              </a>
            </div>
          )}
        </div>
        );
      })}
    </div>
  </div>

  <!-- Controles -->
  {slides.length > 1 && (
    <>
      <button
        type="button"
        class:list={[
          "hero-prev group absolute left-4 bottom-2 sm:bottom-3 md:top-[50%] -translate-y-1/2 z-10",
          // círculo fluido (32px → 52px); el área táctil nunca baja de 44px
          "[--hero-arrow:clamp(2rem,1.5rem_+_1.25vw,3.25rem)]",
          "grid size-[max(44px,var(--hero-arrow))] place-items-center hover:cursor-pointer focus-visible:outline-none",
        ]}
        aria-label={ui.prevLabel}
        data-hero-prev
      >
        <span
          aria-hidden="true"
          class="grid size-[var(--hero-arrow)] place-items-center rounded-full bg-white shadow border border-gray-400 text-[length:calc(var(--hero-arrow)*0.62)] leading-none transition-transform duration-200 group-hover:scale-110 group-focus-visible:ring-2 group-focus-visible:ring-brand group-focus-visible:ring-offset-2"
        >‹</span>
      </button>

      <button
        type="button"
        class:list={[
          "hero-next group absolute right-4 bottom-2 sm:bottom-3 md:top-[50%] -translate-y-1/2 z-10",
          // círculo fluido (32px → 52px); el área táctil nunca baja de 44px
          "[--hero-arrow:clamp(2rem,1.5rem_+_1.25vw,3.25rem)]",
          "grid size-[max(44px,var(--hero-arrow))] place-items-center hover:cursor-pointer focus-visible:outline-none",
        ]}
        aria-label={ui.nextLabel}
        data-hero-next
      >
        <span
          aria-hidden="true"
          class="grid size-[var(--hero-arrow)] place-items-center rounded-full bg-white shadow border border-gray-400 text-[length:calc(var(--hero-arrow)*0.62)] leading-none transition-transform duration-200 group-hover:scale-110 group-focus-visible:ring-2 group-focus-visible:ring-brand group-focus-visible:ring-offset-2"
        >›</span>
      </button>

      <div
        class="absolute bottom-5 left-1/2 z-20 w-20 h-5 flex justify-center -translate-x-1/2 items-center gap-2"
        role="tablist"
        aria-label={ui.dotsLabel}
        data-hero-dots
      >
        {slides.map((_, i) => (
          <button
            type="button"
            class:list={[
              "hero-dot h-2.5 w-2.5 rounded-full ring-1 ring-white/40 transition-transform",
              i === 0 ? "bg-white scale-110" : "bg-white/40 hover:bg-white/70",
            ]}
            aria-label={ui.dotLabel(i)}
            aria-selected={i === 0 ? "true" : "false"}
            role="tab"
            data-hero-dot
            data-index={i}
          />
        ))}
      </div>
    </>
  )}
</section>

<script is:inline src="/scripts/hero-slider.js"></script>

<script>
  import { gsap } from "gsap";

  let activeTl: gsap.core.Timeline | null = null;
  let sliderObserver: MutationObserver | null = null;

  function animatePanel(panelEl: Element, delay = 0.1) {
    const title = panelEl.querySelector("[data-hero-title]");
    if (!title) return;

    activeTl?.kill();

    const tl = gsap.timeline({ delay });

    tl.fromTo(title,
      { y: 20, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.7, ease: "power2.out" }
    );

    const subtitle = panelEl.querySelector("[data-hero-subtitle]");
    if (subtitle) tl.fromTo(subtitle,
      { y: 14, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.6, ease: "power2.out" },
      "-=0.4"
    );

    const cta = panelEl.querySelector("[data-hero-cta]");
    if (cta) tl.fromTo(cta,
      { y: 10, opacity: 0 },
      { y: 0, opacity: 1, duration: 0.55, ease: "power2.out" },
      "-=0.35"
    );

    activeTl = tl;
  }

  function initHeroAnimations() {
    sliderObserver?.disconnect();

    const firstPanel = document.querySelector('[data-hero-panel][data-index="0"]');
    if (!firstPanel) return;
    animatePanel(firstPanel, 0.1);

    const panels = document.querySelectorAll("[data-hero-panel]");
    sliderObserver = new MutationObserver((mutations) => {
      for (const mut of mutations) {
        if (mut.attributeName !== "class") continue;
        const panel = mut.target as Element;
        const wasHidden = (mut.oldValue ?? "").includes("opacity-0");
        const isVisible = panel.classList.contains("opacity-100");
        if (wasHidden && isVisible) {
          animatePanel(panel, 0.15);
        }
      }
    });

    panels.forEach((p) =>
      sliderObserver!.observe(p, {
        attributes: true,
        attributeFilter: ["class"],
        attributeOldValue: true,
      })
    );
  }

  initHeroAnimations();
  document.addEventListener("astro:page-load", initHeroAnimations);
</script>
