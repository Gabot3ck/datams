---
import { Picture } from 'astro:assets';
// Cuadros del upscale del video de la oficina (fuera del tramo que se ve en el
// video de la web). Patente del auto pixelada en la fachada. Proceso en
// reference-data/videos/.
import imgFachada from '../assets/images/office/datamultiservices-fachada-las-vegas.webp';
import imgAsesora from '../assets/images/office/datamultiservices-asesora-oficina.webp';
import imgAsesor from '../assets/images/office/datamultiservices-asesor-oficina.webp';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

// Columnas 1 y 2: 100% en mobile, 50% desde 640px, ~25% desde 990px.
// <990px las fotos son miniaturas de 1/3 del ancho (debajo del video).
const SIZES = '(min-width: 990px) 25vw, 33vw';

const t = {
  es: {
    kicker: "Taxes, notary public e inmigración, en un mismo lugar",
    heading: { pre: "Conoce", accent: "nuestra oficina", post: "en Las Vegas" },
    description:
      "Ven a nuestra oficina en Las Vegas y resuelve en una sola visita lo que normalmente te tomaría ir a tres lugares distintos.",
    cta: "Cómo llegar",
    ctaHref: "https://www.google.com/maps/dir/?api=1&destination=235%20N%20Eastern%20Ave%20Suite%20130%2C%20Las%20Vegas%2C%20NV%2089101",
    images: [
      { src: imgFachada, alt: "Fachada de Data's Multiservices en 235 N Eastern Ave, Las Vegas", position: "object-[50%_30%]" },
      { src: imgAsesora, alt: "Asesora de Data's Multiservices en su escritorio", position: "object-[60%_35%]" },
      { src: imgAsesor, alt: "Asesor de Data's Multiservices en su oficina", position: "object-[50%_35%]" },
    ],
    videoAlt: "Video: nuestro equipo trabajando en la oficina de Las Vegas",
    videoPlay: "Reproducir video",
    videoPause: "Pausar video",
  },
  en: {
    kicker: "Taxes, notary, and immigration help, all in one place",
    heading: { pre: "Visit", accent: "Our Office", post: "in Las Vegas" },
    description:
      "Visit our Las Vegas office and handle in one trip what would normally mean three different stops.",
    cta: "Get Directions",
    ctaHref: "https://www.google.com/maps/dir/?api=1&destination=235%20N%20Eastern%20Ave%20Suite%20130%2C%20Las%20Vegas%2C%20NV%2089101",
    images: [
      { src: imgFachada, alt: "Data's Multiservices storefront at 235 N Eastern Ave, Las Vegas", position: "object-[50%_30%]" },
      { src: imgAsesora, alt: "Data's Multiservices advisor at her desk", position: "object-[60%_35%]" },
      { src: imgAsesor, alt: "Data's Multiservices advisor in his office", position: "object-[50%_35%]" },
    ],
    videoAlt: "Video: our team at work in the Las Vegas office",
    videoPlay: "Play video",
    videoPause: "Pause video",
  },
}[lang];
---

<section class="py-section bg-background-light" aria-labelledby="office-heading">
  <div class="container-custom">

    <!-- Cabecera -->
    <div class="text-center" data-reveal>
      <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
        {t.kicker}
      </span>
      <h2
        id="office-heading"
        class="font-display text-fluid-2xl md:text-fluid-3xl lg:text-fluid-4xl font-bold text-neutral-dark mt-fluid-sm mb-fluid-sm leading-tight text-balance"
      >
        {t.heading.pre}{' '}
        <span class="text-brand">{t.heading.accent}</span>{' '}
        {t.heading.post}
      </h2>
      <p class="text-neutral-grey text-fluid-body leading-relaxed max-w-xl mx-auto text-pretty">
        {t.description}
      </p>
    </div>

    <!-- Medios: 2 imágenes apiladas · 1 imagen vertical · video.
         <990px (mobile y tablet): video arriba a todo el ancho + fila de 3
         miniaturas (cuadradas en mobile, 4:3 desde 640px). La columna 1 pasa
         a display:contents para que sus 2 fotos sean celdas de la grilla. -->
    <div
      class="mt-fluid-xl grid grid-cols-3 gap-3 sm:gap-4
             lg:grid-cols-[1fr_1.1fr_2fr] lg:grid-rows-1 lg:h-[460px]"
      data-reveal
      data-reveal-delay="1"
    >
      <!-- Columna 1: dos imágenes apiladas -->
      <div class="contents lg:flex lg:flex-col lg:gap-4 lg:h-full">
        {t.images.slice(0, 2).map(img => (
          <Picture
            src={img.src}
            alt={img.alt}
            formats={['avif', 'webp']}
            widths={[480, 720, 960, 1440]}
            sizes={SIZES}
            quality={75}
            loading="lazy"
            decoding="async"
            pictureAttributes={{ class: 'block flex-1 min-h-0' }}
            class:list={['w-full aspect-square sm:aspect-[4/3] lg:aspect-auto lg:h-full object-cover rounded-lg sm:rounded-xl', img.position]}
          />
        ))}
      </div>

      <!-- Columna 2: imagen vertical -->
      <Picture
        src={t.images[2].src}
        alt={t.images[2].alt}
        formats={['avif', 'webp']}
        widths={[405, 600, 810]}
        sizes={SIZES}
        quality={75}
        loading="lazy"
        decoding="async"
        pictureAttributes={{ class: 'block lg:h-full' }}
        class:list={['w-full aspect-square sm:aspect-[4/3] lg:aspect-auto lg:h-full object-cover rounded-lg sm:rounded-xl', t.images[2].position]}
      />

      <!-- Columna 3: video en bucle, sin audio. Se reproduce solo cuando está
           en pantalla y nunca con prefers-reduced-motion. El botón de pausa
           cumple WCAG 2.2.2 (movimiento de más de 5 s). Fuente y proceso en
           reference-data/videos/ (gitignored). -->
      <figure
        class="relative col-span-3 order-first lg:order-none lg:col-span-1 lg:h-full overflow-hidden rounded-xl bg-midnight"
        data-office-video
      >
        <video
          class="w-full aspect-video lg:aspect-auto lg:h-full object-cover"
          poster="/assets/video/datamultiservices-oficina-las-vegas-poster.webp"
          width="1920"
          height="1080"
          muted
          loop
          playsinline
          preload="none"
          aria-label={t.videoAlt}
        >
          <source src="/assets/video/datamultiservices-oficina-las-vegas.webm" type="video/webm" />
          <source src="/assets/video/datamultiservices-oficina-las-vegas.mp4" type="video/mp4" />
        </video>
        <button
          type="button"
          class="absolute bottom-3 left-3 flex size-11 items-center justify-center rounded-full
                 bg-black/55 text-white transition-colors hover:bg-black/75
                 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          aria-label={t.videoPlay}
          data-label-play={t.videoPlay}
          data-label-pause={t.videoPause}
          data-video-toggle
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true" data-icon-play>
            <path d="M6.3 2.84A1.5 1.5 0 0 0 4 4.11v11.78a1.5 1.5 0 0 0 2.3 1.27l9.34-5.89a1.5 1.5 0 0 0 0-2.54L6.3 2.84Z" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 hidden" aria-hidden="true" data-icon-pause>
            <path d="M6 4.75A.75.75 0 0 1 6.75 4h1.5a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1-.75-.75V4.75ZM11 4.75A.75.75 0 0 1 11.75 4h1.5a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1-.75-.75V4.75Z" />
          </svg>
        </button>
      </figure>

    </div>

    <!-- CTA: cómo llegar -->
    <div class="mt-fluid-xl text-center" data-reveal>
      <a
        href={t.ctaHref}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="shrink-0" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" />
        </svg>
        {t.cta}
      </a>
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-office-video]').forEach((figure) => {
    const video = figure.querySelector('video');
    const button = figure.querySelector<HTMLButtonElement>('[data-video-toggle]');
    if (!video || !button) return;

    const iconPlay = button.querySelector('[data-icon-play]');
    const iconPause = button.querySelector('[data-icon-pause]');
    // Si la persona pausa, el scroll no vuelve a reproducirlo.
    let userPaused = false;

    const sync = () => {
      const playing = !video.paused;
      iconPlay?.classList.toggle('hidden', playing);
      iconPause?.classList.toggle('hidden', !playing);
      button.setAttribute('aria-label', (playing ? button.dataset.labelPause : button.dataset.labelPlay) ?? '');
    };
    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);

    button.addEventListener('click', () => {
      if (video.paused) {
        userPaused = false;
        video.play().catch(() => {});
      } else {
        userPaused = true;
        video.pause();
      }
    });

    // preload="none": el archivo recién se descarga al entrar en pantalla.
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          if (!userPaused && !reduceMotion.matches) video.play().catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      },
      { threshold: 0.25 },
    ).observe(figure);
  });
</script>
