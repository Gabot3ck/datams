---
interface ServiceItem {
  label: string;
  description: string;
  href: string;
  cta: string;
  icon: string;
  width?: number;
}

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const t: {
  sectionLabel: string;
  heading: string;
  subheading: string;
  items: ServiceItem[];
} = {
  es: {
    sectionLabel: "Nuestros servicios",
    heading: "Todo lo que necesitas, en un solo lugar",
    subheading: "Soluciones integrales para tu situación fiscal, notarial y empresarial",
    items: [
      {
        label: "Taxes",
        description: "Declaramos tus taxes en español en Las Vegas: personal, negocio y enmiendas. Revisamos cada deducción para maximizar tu reembolso.",
        href: "/taxes",
        cta: "Conocer más",
        icon: "taxes.svg",
      },
      {
        label: "IRS",
        description: "Te ayudamos con deudas, acuerdos de pago, cartas y auditorías del IRS en español, con representación real ante el IRS.",
        href: "/irs",
        cta: "Conocer más",
        icon: "irs.png",
        width: 90,
      },
      {
        label: "ITIN - EIN",
        description: "Solicitamos y renovamos tu ITIN number o EIN para negocio, aunque no tengas número de Social Security.",
        href: "/itin-ein",
        cta: "Conocer más",
        icon: "itin.png",
        width: 90,
      },
      {
        label: "Notary Public",
        description: "Notario público en Las Vegas: power of attorney, apostillas, contratos, permisos de viaje para menores y más.",
        href: "/notaria",
        cta: "Conocer más",
        icon: "notary.png",
        width: 80,
      },
      {
        label: "Inmigración",
        description: "Renovación de DACA, residencia permanente, ciudadanía, permisos de trabajo y peticiones familiares, todo en español.",
        href: "/inmigracion",
        cta: "Conocer más",
        icon: "immigration.png",
        width: 200,
      },
      {
        label: "DMV",
        description: "Citas DMV en español, registro de vehículo, permiso de conducir, placas, duplicado de título y traducciones certificadas.",
        href: "/dmv",
        cta: "Conocer más",
        icon: "dmv.png",
        width: 90,
      },
    ],
  },
  en: {
    sectionLabel: "Our services",
    heading: "Everything you need, all in one place",
    subheading: "Comprehensive solutions for your tax, notary, and business needs",
  items: [
    {
      label: "Taxes",
      description: "Personal and business tax preparation in Las Vegas, plus amended returns. We review every deduction to maximize your refund.",
      href: "/en/taxes",
      cta: "Learn more",
      icon: "taxes.svg",
    },
    {
      label: "IRS",
      description: "We help with IRS debt, payment plans, notices, and audits — with real representation in Las Vegas.",
      href: "/en/irs",
      cta: "Learn more",
      icon: "irs.png",
      width: 90,
    },
    {
      label: "ITIN - EIN",
      description: "We file and renew your ITIN or business EIN in Las Vegas, even without a Social Security number.",
      href: "/en/itin-ein",
      cta: "Learn more",
      icon: "itin.png",
      width: 90,
    },
    {
      label: "Notary Public",
      description: "Notary public in Las Vegas: power of attorney, apostilles, contracts, travel consent for minors, and more.",
      href: "/en/notary",
      cta: "Learn more",
      icon: "notary.png",
      width: 90,
    },
    {
      label: "Immigration",
      description: "DACA renewal, green card, citizenship, work permits, and family petitions in Las Vegas.",
      href: "/en/immigration",
      cta: "Learn more",
      icon: "immigration.png",
      width: 90,
    },
    {
      label: "DMV",
      description: "DMV appointments, vehicle registration, driver's license, license plates, duplicate title, and certified translations in Las Vegas.",
      href: "/en/dmv",
      cta: "Learn more",
      icon: "dmv.png",
      width: 100,
    },
  ]
  },
}[lang];

const sectionId = lang === 'es' ? 'servicios' : 'services';
---

<section
  id={sectionId}
  class="py-24 bg-gray-100 dark:bg-accent-dark"
  aria-labelledby="services-heading"
>
  <div class="container-custom">

    <!-- Section header -->
    <header class="text-center mb-16" data-reveal>
      <p class="text-brand text-lg max-w-xl mx-auto font-bold leading-relaxed">
        {t.sectionLabel}
      </p>
      <h2
        id="services-heading"
        class="font-display text-4xl md:text-5xl font-bold text-dark mt-3 mb-4 leading-tight"
      >
        {t.heading}
      </h2>
      <p class="text-dark text-xl max-w-xl mx-auto leading-relaxed">
        {t.subheading}
      </p>
    </header>

    <!-- Service cards -->
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8" role="list">
      {t.items.map((service, i) => (
        <li
          class="group/card flex flex-col bg-white border border-background-muted rounded-2xl p-8 lg:p-10
                 transition-all duration-500"
          data-reveal
          data-reveal-delay={String(i + 1)}
        >

          <!-- Icon box -->
          <div
            class="mb-4 flex items-center justify-start transition-all duration-300 shrink-0"
            aria-hidden="true"
          >
            <img
              src={`/assets/icons/${service.icon}`}
              alt=""
              width={ service.width ?? 48 }
              height="48"
              loading="lazy"
              class="text-brand"
            />
          </div>

          <!-- Card content -->
          <article class="flex flex-col flex-1">
            <h3
              class="font-display text-xl font-bold text-neutral-dark
                    transition-colors duration-300 mb-3 leading-snug"
            >
              {service.label}
            </h3>

            <p
              class="text-sm text-neutral-grey leading-relaxed mb-2 flex-1"
            >
              {service.description}
            </p>

            <!-- CTA pill button -->
            <a
              href={service.href}
              class="inline-flex items-start gap-3 text-brand text-md font-semibold
                    hover:underline transition-all duration-300"
              aria-label={`${service.cta} — ${service.label}`}
            >
              {service.cta}
              <!-- Arrow circle -->
              <span
                class="size-6 flex items-center justify-center shrink-0 duration-300"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-3 text-brand-dark"
                >
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </article>

        </li>
      ))}
    </ul>

  </div>
</section>
