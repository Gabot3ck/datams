---
interface ServiceItem {
  num: string;
  label: string;
  description: string;
  href: string;
  cta: string;
}

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const t: {
  sectionLabel: string;
  heading: string;
  subheading: string;
  items: ServiceItem[];
} = {
  es: {
    sectionLabel: "Nuestros servicios",
    heading: "Todo lo que necesitas, en un solo lugar",
    subheading: "Soluciones integrales para tu situación fiscal, notarial y empresarial",
    items: [
      {
        num: "01",
        label: "Impuestos",
        description: "Preparación de declaraciones federales y estatales, ITIN, enmiendas y asesoría fiscal para individuos y familias hispanas.",
        href: "/taxes",
        cta: "Conocer más",
      },
      {
        num: "02",
        label: "Notaría",
        description: "Apostille, certificación de documentos, poderes notariales y traducción oficial de documentos para trámites en EE.UU. y el extranjero.",
        href: "/notaria",
        cta: "Conocer más",
      },
      {
        num: "03",
        label: "Servicios Corporativos",
        description: "Apertura de LLC, obtención de EIN, registro de negocios y asesoría integral para emprendedores hispanos.",
        href: "/negocio",
        cta: "Conocer más",
      },
    ],
  },
  en: {
    sectionLabel: "Our services",
    heading: "Everything you need, all in one place",
    subheading: "Comprehensive solutions for your tax, notary, and business needs",
    items: [
      {
        num: "01",
        label: "Taxes",
        description: "Federal and state tax return preparation, ITIN applications, amendments, and tax advice for Hispanic individuals and families.",
        href: "/en/taxes",
        cta: "Learn more",
      },
      {
        num: "02",
        label: "Notary",
        description: "Apostille, document certification, notarial powers of attorney, and official document translation for U.S. and international use.",
        href: "/en/notary",
        cta: "Learn more",
      },
      {
        num: "03",
        label: "Business Services",
        description: "LLC formation, EIN registration, business registration, and comprehensive advisory services for Hispanic entrepreneurs.",
        href: "/en/business",
        cta: "Learn more",
      },
    ],
  },
}[lang];

const sectionId = lang === 'es' ? 'servicios' : 'services';

// One SVG path string per service — avoids index conditionals in the template.
const iconPaths: string[] = [
  // Tax form / document
  `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.638 4.5 4.718V19.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V4.718c0-1.08-.807-2.018-1.907-2.146A48.424 48.424 0 0 0 12 2.25Z" />`,
  // Notary / ticket stamp
  `<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 0 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 0 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />`,
  // Business / building
  `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />`,
];
---

<section
  id={sectionId}
  class="py-24 bg-background-light"
  aria-labelledby="services-heading"
>
  <div class="container-custom">

    <!-- Section header -->
    <header class="text-center mb-16" data-reveal>
      <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
        {t.sectionLabel}
      </span>
      <h2
        id="services-heading"
        class="font-display text-4xl md:text-5xl font-bold text-neutral-dark mt-3 mb-4 leading-tight"
      >
        {t.heading}
      </h2>
      <p class="text-neutral-grey max-w-xl mx-auto leading-relaxed">
        {t.subheading}
      </p>
    </header>

    <!-- Service cards -->
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8" role="list">
      {t.items.map((service, i) => (
        <li
          class="group relative bg-white rounded-2xl p-8 lg:p-10 shadow-sm
                 hover:shadow-xl overflow-hidden transition-all duration-300"
          data-reveal
          data-reveal-delay={String(i + 1)}
        >
          <!-- Animated left accent bar -->
          <span
            class="absolute left-0 inset-y-0 w-[3px] bg-brand-light
                   scale-y-0 group-hover:scale-y-100
                   transition-transform duration-300 origin-bottom rounded-r-full"
            aria-hidden="true"
          ></span>

          <!-- Decorative background number -->
          <span
            class="absolute top-4 right-5 font-display text-[6rem] font-bold
                   text-neutral-dark/[0.035] leading-none select-none pointer-events-none"
            aria-hidden="true"
          >
            {service.num}
          </span>

          <!-- Top row: num badge + icon -->
          <div class="flex items-center justify-between mb-7 relative">
            <span class="font-display text-xs font-bold tracking-widest text-brand-light/40">
              {service.num}
            </span>
            <div
              class="size-11 rounded-xl bg-brand-light/10 flex items-center justify-center
                     text-brand-light group-hover:bg-brand-light group-hover:text-white
                     transition-all duration-300"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5"
                aria-hidden="true"
              >
                <Fragment set:html={iconPaths[i]} />
              </svg>
            </div>
          </div>

          <!-- Card content -->
          <article>
            <h3 class="font-display text-2xl font-bold text-neutral-dark mb-3">
              {service.label}
            </h3>
            <span class="block w-8 h-0.5 bg-brand-light mb-4" aria-hidden="true"></span>
            <p class="text-sm text-neutral-grey leading-relaxed mb-7">
              {service.description}
            </p>
            <a
              href={service.href}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-light
                     hover:text-brand-dark transition-colors group/link"
              aria-label={`${service.cta} — ${service.label}`}
            >
              {service.cta}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 20 20"
                fill="currentColor"
                class="size-4 group-hover/link:translate-x-0.5 transition-transform"
                aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
              </svg>
            </a>
          </article>
        </li>
      ))}
    </ul>

  </div>
</section>
