---
interface ServiceItem {
  label: string;
  description: string;
  href: string;
  cta: string;
}

interface Props {
  lang: 'es' | 'en';
}

const { lang } = Astro.props;

const t: {
  sectionLabel: string;
  heading: string;
  subheading: string;
  items: ServiceItem[];
} = {
  es: {
    sectionLabel: "Nuestros servicios",
    heading: "Todo lo que necesitas, en un solo lugar",
    subheading: "Soluciones integrales para tu situación fiscal, notarial y empresarial",
    items: [
      {
        label: "Impuestos",
        description: "Preparación de declaraciones federales y estatales, ITIN, enmiendas y asesoría fiscal para individuos y familias hispanas.",
        href: "/taxes",
        cta: "Conocer más",
      },
      {
        label: "Notaría",
        description: "Apostille, certificación de documentos, poderes notariales y traducción oficial de documentos para trámites en EE.UU. y el extranjero.",
        href: "/notaria",
        cta: "Conocer más",
      },
      {
        label: "Servicios Corporativos",
        description: "Apertura de LLC, obtención de EIN, registro de negocios y asesoría integral para emprendedores hispanos.",
        href: "/negocio",
        cta: "Conocer más",
      },
      {
        label: "Impuestos",
        description: "Preparación de declaraciones federales y estatales, ITIN, enmiendas y asesoría fiscal para individuos y familias hispanas.",
        href: "/taxes",
        cta: "Conocer más",
      },
      {
        label: "Notaría",
        description: "Apostille, certificación de documentos, poderes notariales y traducción oficial de documentos para trámites en EE.UU. y el extranjero.",
        href: "/notaria",
        cta: "Conocer más",
      },
      {
        label: "Servicios Corporativos",
        description: "Apertura de LLC, obtención de EIN, registro de negocios y asesoría integral para emprendedores hispanos.",
        href: "/negocio",
        cta: "Conocer más",
      },
    ],
  },
  en: {
    sectionLabel: "Our services",
    heading: "Everything you need, all in one place",
    subheading: "Comprehensive solutions for your tax, notary, and business needs",
    items: [
      {
        label: "Taxes",
        description: "Federal and state tax return preparation, ITIN applications, amendments, and tax advice for Hispanic individuals and families.",
        href: "/en/taxes",
        cta: "Learn more",
      },
      {
        label: "Notary",
        description: "Apostille, document certification, notarial powers of attorney, and official document translation for U.S. and international use.",
        href: "/en/notary",
        cta: "Learn more",
      },
      {
        label: "Business Services",
        description: "LLC formation, EIN registration, business registration, and comprehensive advisory services for Hispanic entrepreneurs.",
        href: "/en/business",
        cta: "Learn more",
      },
    ],
  },
}[lang];

const sectionId = lang === 'es' ? 'servicios' : 'services';

// Temporary placeholder icon — replace per-item once real icons are defined
const iconPath = `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.638 4.5 4.718V19.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V4.718c0-1.08-.807-2.018-1.907-2.146A48.424 48.424 0 0 0 12 2.25Z" />`;
---

<section
  id={sectionId}
  class="py-24 bg-brand"
  aria-labelledby="services-heading"
>
  <div class="container-custom">

    <!-- Section header -->
    <header class="text-center mb-16" data-reveal>
      <h2
        id="services-heading"
        class="font-display text-4xl md:text-5xl font-bold text-white mt-3 mb-4 leading-tight"
      >
        {t.heading}
      </h2>
      <p class="text-white text-xl max-w-xl mx-auto leading-relaxed">
        {t.subheading}
      </p>
    </header>

    <!-- Service cards -->
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8" role="list">
      {t.items.map((service, i) => (
        <li
          class="group/card flex flex-col bg-white border border-background-muted rounded-2xl p-8 lg:p-10
                 transition-all duration-500"
          data-reveal
          data-reveal-delay={String(i + 1)}
        >

          <!-- Icon box -->
          <div
            class="mb-4 flex items-center justify-start text-brand 
                   transition-all duration-300 shrink-0"
            aria-hidden="true"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-12"
            >
              <Fragment set:html={iconPath} />
            </svg>
          </div>

          <!-- Card content -->
          <article class="flex flex-col flex-1">
            <h3
              class="font-display text-xl font-bold text-neutral-dark
                    transition-colors duration-300 mb-3 leading-snug"
            >
              {service.label}
            </h3>

            <p
              class="text-sm text-neutral-grey leading-relaxed mb-2 flex-1"
            >
              {service.description}
            </p>

            <!-- CTA pill button -->
            <a
              href={service.href}
              class="inline-flex items-start gap-3 text-brand text-md font-semibold
                    hover:underline transition-all duration-300"
              aria-label={`${service.cta} — ${service.label}`}
            >
              {service.cta}
              <!-- Arrow circle -->
              <span
                class="size-6 flex items-center justify-center shrink-0 duration-300"
                aria-hidden="true"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="size-3 text-brand-dark"
                >
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </span>
            </a>
          </article>

        </li>
      ))}
    </ul>

  </div>
</section>
