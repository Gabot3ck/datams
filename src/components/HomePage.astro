---
import Hero from './Hero.astro';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

const t = {
  es: {
    community: {
      label: "Nuestra comunidad",
      heading: { pre: "El aliado de confianza de la", accent: "comunidad hispana", post: "en EE.UU." },
      description: "Ayudamos a familias, negocios e inmigrantes con sus trámites de taxes, notaría e inmigración. Profesionalismo, experiencia y atención 100% en español.",
      cta: "Agendar cita gratis",
      ctaHref: "/contacto",
      trust: ["IRS Authorized CAA", "Notary Public Certificada", "Servicio bilingüe"],
      stats: [
        { value: "10+", label: "Años de experiencia" },
        { value: "5,000+", label: "Familias atendidas" },
        { value: "50+", label: "Servicios disponibles" },
        { value: "100%", label: "Atención en español e inglés" },
      ],
    },
    services: {
      sectionLabel: "Nuestros servicios",
      heading: "Todo lo que necesitas, en un solo lugar",
      subheading: "Soluciones integrales para tu situación fiscal, notarial y empresarial",
      items: [
        {
          num: "01",
          label: "Impuestos",
          description: "Preparación de declaraciones federales y estatales, ITIN, enmiendas y asesoría fiscal para individuos y familias hispanas.",
          href: "/taxes",
          cta: "Conocer más"
        },
        {
          num: "02",
          label: "Notaría",
          description: "Apostille, certificación de documentos, poderes notariales y traducción oficial de documentos para trámites en EE.UU. y el extranjero.",
          href: "/notaria",
          cta: "Conocer más"
        },
        {
          num: "03",
          label: "Servicios Corporativos",
          description: "Apertura de LLC, obtención de EIN, registro de negocios y asesoría integral para emprendedores hispanos.",
          href: "/negocio",
          cta: "Conocer más"
        }
      ]
    },
    stats: [
      { value: "10+", label: "Años de experiencia" },
      { value: "5,000+", label: "Clientes atendidos" },
      { value: "100%", label: "Servicio en español" },
      { value: "3", label: "Oficinas disponibles" }
    ],
    whyUs: {
      sectionLabel: "Por qué elegirnos",
      heading: "El profesionalismo que la comunidad hispana merece",
      description: "Entendemos los desafíos únicos que enfrentan las familias y negocios hispanos en Estados Unidos. Por eso ofrecemos un servicio cálido, profesional y completamente en tu idioma.",
      items: [
        "Atención 100% en español e inglés",
        "Profesionales certificados y licenciados",
        "Precios transparentes sin sorpresas",
        "Horarios flexibles incluyendo fines de semana",
        "Manejo seguro y confidencial de tus datos",
        "Más de 10 años sirviendo a la comunidad"
      ]
    },
    cta: {
      eyebrow: "Resolving your pathway to success",
      heading: "¿Listo para resolver tu situación fiscal?",
      subheading: "Agenda una consulta sin costo y descubre cómo podemos ayudarte con tus trámites fiscales, notariales y corporativos.",
      button: "Agendar cita gratis",
      href: "/contacto",
      phone: "(702) 640-0088",
      address: "235 N Eastern Ave. Suite 130, Las Vegas, NV. 89101",
      hours: "Lun–Sáb 9AM–9PM · Dom 10AM–5PM"
    }
  },
  en: {
    community: {
      label: "Our community",
      heading: { pre: "The trusted partner of the", accent: "Hispanic community", post: "in the U.S." },
      description: "We help families, businesses, and immigrants with their tax, notary, and immigration needs. Professional service, fully bilingual in Spanish and English.",
      cta: "Book free appointment",
      ctaHref: "/en/contact",
      trust: ["IRS Authorized CAA", "Certified Notary Public", "Fully bilingual service"],
      stats: [
        { value: "10+", label: "Years of experience" },
        { value: "5,000+", label: "Families served" },
        { value: "50+", label: "Services available" },
        { value: "100%", label: "Spanish & English service" },
      ],
    },
    services: {
      sectionLabel: "Our services",
      heading: "Everything you need, all in one place",
      subheading: "Comprehensive solutions for your tax, notary, and business needs",
      items: [
        {
          num: "01",
          label: "Taxes",
          description: "Federal and state tax return preparation, ITIN applications, amendments, and tax advice for Hispanic individuals and families.",
          href: "/en/taxes",
          cta: "Learn more"
        },
        {
          num: "02",
          label: "Notary",
          description: "Apostille, document certification, notarial powers of attorney, and official document translation for U.S. and international use.",
          href: "/en/notary",
          cta: "Learn more"
        },
        {
          num: "03",
          label: "Business Services",
          description: "LLC formation, EIN registration, business registration, and comprehensive advisory services for Hispanic entrepreneurs.",
          href: "/en/business",
          cta: "Learn more"
        }
      ]
    },
    stats: [
      { value: "10+", label: "Years of experience" },
      { value: "5,000+", label: "Clients served" },
      { value: "100%", label: "Bilingual service" },
      { value: "3", label: "Office locations" }
    ],
    whyUs: {
      sectionLabel: "Why choose us",
      heading: "The professionalism the Hispanic community deserves",
      description: "We understand the unique challenges faced by Hispanic families and businesses in the United States. That's why we offer a warm, professional service fully in your language.",
      items: [
        "100% bilingual service in Spanish and English",
        "Certified and licensed professionals",
        "Transparent pricing with no surprises",
        "Flexible hours including weekends",
        "Secure and confidential data handling",
        "Over 10 years serving the community"
      ]
    },
    cta: {
      eyebrow: "Resolving your pathway to success",
      heading: "Ready to resolve your tax situation?",
      subheading: "Schedule a free consultation and discover how we can help with your tax, notary, and business needs.",
      button: "Book free appointment",
      href: "/en/contact",
      phone: "(702) 640-0088",
      address: "235 N Eastern Ave. Suite 130, Las Vegas, NV. 89101",
      hours: "Mon–Sat 9AM–9PM · Sun 10AM–5PM"
    }
  }
}[lang];

const sectionId = lang === 'es' ? 'servicios' : 'services';
---

<main>
  <!-- HERO SLIDER -->
  <Hero lang={lang} />

  <!-- ─── COMMUNITY & STATS ─────────────────────────────────────────── -->
  <section class="bg-white" aria-labelledby="community-heading">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row items-stretch">

        <!-- LEFT: copy panel -->
        <div
          class="flex-1 py-20 lg:py-28 lg:pr-16 xl:pr-24 flex flex-col justify-center border-b lg:border-b-0 lg:border-r border-background-muted"
          data-reveal
        >
          <!-- Label -->
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-brand-light shrink-0" aria-hidden="true"></span>
            <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
              {t.community.label}
            </span>
          </div>

          <!-- Heading -->
          <h2
            id="community-heading"
            class="font-display text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-neutral-dark leading-[1.1] mb-6"
          >
            {t.community.heading.pre}{' '}
            <em class="not-italic text-brand-light">{t.community.heading.accent}</em>
            {t.community.heading.post && <>{' '}{t.community.heading.post}</>}
          </h2>

          <!-- Description -->
          <p class="text-neutral-grey leading-relaxed mb-8 max-w-[480px]">
            {t.community.description}
          </p>

          <!-- CTA -->
          <a
            href={t.community.ctaHref}
            class="self-start inline-flex items-center gap-2 rounded-full bg-brand-light px-7 py-3.5 text-sm font-semibold text-white hover:bg-brand-dark transition-colors focus-visible:outline-2 focus-visible:outline-brand-light mb-10"
          >
            {t.community.cta}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>

          <!-- Trust indicators -->
          <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
            {t.community.trust.map(item => (
              <li class="flex items-center gap-1.5 text-xs font-medium text-neutral-grey">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3.5 text-brand-light shrink-0" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- RIGHT: stats en fondo claro -->
        <div class="lg:w-[45%] flex-shrink-0 bg-background-light flex items-center">
          <dl class="grid grid-cols-2 w-full h-full">
            {t.community.stats.map((stat, i) => (
              <div
                class:list={[
                  "flex flex-col items-center justify-center text-center py-12 px-6 group cursor-default",
                  (i === 1 || i === 3) && "border-l border-background-muted",
                  (i === 2 || i === 3) && "border-t border-background-muted",
                ]}
                data-reveal
                data-reveal-delay={String(i)}
              >
                <dt class="font-display text-5xl lg:text-6xl font-bold text-brand-light leading-none group-hover:text-brand-dark transition-colors duration-300">
                  {stat.value}
                </dt>
                <dd class="text-xs sm:text-sm text-neutral-grey mt-3 leading-snug max-w-[130px]">
                  {stat.label}
                </dd>
              </div>
            ))}
          </dl>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── SERVICES ──────────────────────────────────────────────────── -->
  <section id={sectionId} class="py-24 bg-background-light" aria-labelledby="services-heading">
    <div class="container-custom">

      <!-- Header -->
      <div class="text-center mb-16" data-reveal>
        <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
          {t.services.sectionLabel}
        </span>
        <h2
          id="services-heading"
          class="font-display text-4xl md:text-5xl font-bold text-neutral-dark mt-3 mb-4 leading-tight"
        >
          {t.services.heading}
        </h2>
        <p class="text-neutral-grey max-w-xl mx-auto leading-relaxed">
          {t.services.subheading}
        </p>
      </div>

      <!-- Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {t.services.items.map((service, i) => (
          <article
            class="group relative bg-white rounded-2xl p-8 lg:p-10 shadow-sm
                   hover:shadow-xl overflow-hidden transition-all duration-300"
            data-reveal
            data-reveal-delay={String(i + 1)}
          >
            <!-- Animated left accent bar -->
            <span
              class="absolute left-0 inset-y-0 w-[3px] bg-brand-light
                     scale-y-0 group-hover:scale-y-100
                     transition-transform duration-300 origin-bottom rounded-r-full"
              aria-hidden="true"
            ></span>

            <!-- Decorative background number -->
            <span
              class="absolute top-4 right-5 font-display text-[6rem] font-bold
                     text-neutral-dark/[0.035] leading-none select-none pointer-events-none"
              aria-hidden="true"
            >
              {service.num}
            </span>

            <!-- Top row: num badge + icon -->
            <div class="flex items-center justify-between mb-7 relative">
              <span class="font-display text-xs font-bold tracking-widest text-brand-light/40">
                {service.num}
              </span>
              <div
                class="size-11 rounded-xl bg-brand-light/10 flex items-center justify-center
                       text-brand-light group-hover:bg-brand-light group-hover:text-white
                       transition-all duration-300"
              >
                {i === 0 && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.638 4.5 4.718V19.5a1.5 1.5 0 0 0 1.5 1.5h12a1.5 1.5 0 0 0 1.5-1.5V4.718c0-1.08-.807-2.018-1.907-2.146A48.424 48.424 0 0 0 12 2.25Z" />
                  </svg>
                )}
                {i === 1 && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 0 0 0 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 0 0 0-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375Z" />
                  </svg>
                )}
                {i === 2 && (
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75 3.75h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Zm0 3h.008v.008h-.008v-.008Z" />
                  </svg>
                )}
              </div>
            </div>

            <!-- Content -->
            <h3 class="font-display text-2xl font-bold text-neutral-dark mb-3 relative">
              {service.label}
            </h3>
            <span class="block w-8 h-0.5 bg-brand-light mb-4" aria-hidden="true"></span>
            <p class="text-sm text-neutral-grey leading-relaxed mb-7 relative">
              {service.description}
            </p>

            <a
              href={service.href}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-light
                     hover:text-brand-dark transition-colors relative group/link"
              aria-label={`${service.cta} — ${service.label}`}
            >
              {service.cta}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 group-hover/link:translate-x-0.5 transition-transform" aria-hidden="true">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
              </svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── STATS BAR ─────────────────────────────────────────────────── -->
  <section class="bg-accent py-16 lg:py-20" aria-label={lang === 'es' ? 'Estadísticas' : 'Statistics'}>
    <div class="container-custom">
      <ul class="grid grid-cols-2 lg:grid-cols-4" role="list">
        {t.stats.map((stat, i) => (
          <li
            class:list={[
              "flex flex-col items-center py-10 px-6 text-center group cursor-default",
              i > 0 && "border-l border-white/10"
            ]}
            data-reveal
            data-reveal-delay={String(i)}
          >
            <span
              class="font-display text-5xl xl:text-6xl font-bold text-white
                     group-hover:text-brand-light transition-colors duration-300"
              aria-label={stat.value}
            >
              {stat.value}
            </span>
            <span class="text-xs text-white/50 font-medium mt-3 tracking-wide leading-snug max-w-[100px]">
              {stat.label}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── WHY US ────────────────────────────────────────────────────── -->
  <section class="py-24 bg-cream" aria-labelledby="whyus-heading">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-center">

        <!-- Left: Text -->
        <div class="flex-1 max-w-lg text-center lg:text-left" data-reveal>
          <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
            {t.whyUs.sectionLabel}
          </span>
          <h2
            id="whyus-heading"
            class="font-display text-4xl md:text-5xl font-bold text-neutral-dark mt-4 mb-6 leading-tight"
          >
            {t.whyUs.heading}
          </h2>
          <p class="text-neutral-grey leading-relaxed mb-8 max-w-md mx-auto lg:mx-0">
            {t.whyUs.description}
          </p>
          <a
            href={t.cta.href}
            class="inline-flex items-center gap-2 rounded-full bg-brand-light
                   px-7 py-3.5 text-sm font-semibold text-white
                   hover:bg-brand-dark transition-colors"
          >
            {t.cta.button}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        <!-- Right: Checklist -->
        <div class="flex-1 w-full" data-reveal data-reveal-delay="1">
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
            {t.whyUs.items.map(item => (
              <li class="flex items-start gap-3 bg-white rounded-2xl p-5 shadow-sm hover:shadow-md transition-shadow duration-200">
                <span
                  class="shrink-0 mt-0.5 size-6 rounded-full bg-brand-light
                         flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5 text-white">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                </span>
                <span class="text-sm text-neutral-dark font-medium leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── CTA BANNER ────────────────────────────────────────────────── -->
  <section class="bg-midnight" aria-labelledby="cta-heading">

    <!-- Main CTA -->
    <div class="container-custom py-20 lg:py-28 text-center" data-reveal>

      <!-- Eyebrow with decorative lines -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <span class="h-px w-12 bg-brand-light/60" aria-hidden="true"></span>
        <span class="text-xs font-bold tracking-widest text-brand-light/80 uppercase">
          {t.cta.eyebrow}
        </span>
        <span class="h-px w-12 bg-brand-light/60" aria-hidden="true"></span>
      </div>

      <h2
        id="cta-heading"
        class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white
               mb-6 leading-tight max-w-3xl mx-auto"
      >
        {t.cta.heading}
      </h2>

      <p class="text-white/60 mb-10 max-w-xl mx-auto leading-relaxed">
        {t.cta.subheading}
      </p>

      <a
        href={t.cta.href}
        class="inline-flex items-center gap-2 rounded-full bg-brand-light
               px-8 py-4 text-base font-semibold text-white
               hover:bg-brand-dark transition-colors shadow-lg
               focus-visible:outline-2 focus-visible:outline-brand-light"
      >
        {t.cta.button}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>

    <!-- Contact info strip -->
    <address class="not-italic border-t border-white/10">
      <div class="container-custom py-5">
        <ul
          class="flex flex-col sm:flex-row flex-wrap items-center justify-center
                 gap-3 sm:gap-6 text-center"
          role="list"
        >
          <!-- Phone -->
          <li>
            <a
              href="tel:7026400088"
              class="inline-flex items-center gap-2 text-white/60 hover:text-white
                     transition-colors text-sm font-medium"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 text-brand-light shrink-0" aria-hidden="true">
