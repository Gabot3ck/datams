---
import Hero from './Hero.astro';
import ServicesSection from './ServicesSection.astro';


interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

const t = {
  es: {
    community: {
      label: "Nuestra comunidad",
      heading: { pre: "El aliado de confianza de la", accent: "comunidad hispana", post: "en Las Vegas y EE.UU." },
      description: "Ayudamos a familias, negocios e inmigrantes con sus trámites de taxes, notaría e inmigración. Profesionalismo, experiencia y atención 100% en español.",
      cta: "Agendar cita gratis",
      ctaHref: "/contacto",
      trust: ["IRS Authorized CAA", "Notary Public Certificada", "Servicio bilingüe"],
      stats: [
        { value: "10+", label: "Años de experiencia" },
        { value: "5,000+", label: "Familias atendidas" },
        { value: "50+", label: "Servicios disponibles" },
        { value: "100%", label: "Atención en español e inglés" },
      ],
    },
    stats: [
      { value: "10+", label: "Años de experiencia" },
      { value: "5,000+", label: "Clientes atendidos" },
      { value: "100%", label: "Servicio en español" },
      { value: "3", label: "Oficinas disponibles" }
    ],
    whyUs: {
      eyebrow: "¿Por qué elegirnos?",
      heading: { pre: "No solo asesoramos,", accent: "resolvemos." },
      description:
        "Sabemos que detrás de cada trámite hay una familia que no quiere una carta del IRS ni vivir con incertidumbre. Resolvemos tus taxes, notaría e inmigración en un solo lugar de confianza, en español, con precio claro desde el inicio y un comprobante en tus manos de que todo quedó bien hecho.",
      items: [
        "Tus taxes completos y sin errores que después traigan cartas del IRS",
        "El reembolso más alto que la ley permite, 100% legal",
        "Taxes, ITIN, notaría e inmigración en una sola oficina",
        "Precio exacto antes de empezar y comprobante de que quedó bien hecho",
      ],
      imageAlt: "David Takamura, notario público certificado",
    },
    cta: {
      eyebrow: "Resolving your pathway to success",
      heading: "¿Listo para resolver tu situación fiscal?",
      subheading: "Agenda una consulta sin costo y descubre cómo podemos ayudarte con tus trámites fiscales, notariales y corporativos.",
      button: "Agendar cita gratis",
      href: "/contacto",
      phone: "(702) 640-0088",
      address: "235 N Eastern Ave. Suite 130, Las Vegas, NV. 89101",
      hours: "Lun–Sáb 9AM–9PM · Dom 10AM–5PM"
    }
  },
  en: {
    community: {
      label: "Our community",
      heading: { pre: "The trusted partner of the", accent: "Hispanic community", post: "in the Las Vegas and U.S." },
      description: "We help families, businesses, and immigrants with their tax, notary, and immigration needs. Professional service, fully bilingual in Spanish and English.",
      cta: "Book free appointment",
      ctaHref: "/en/contact",
      trust: ["IRS Authorized CAA", "Certified Notary Public", "Fully bilingual service"],
      stats: [
        { value: "10+", label: "Years of experience" },
        { value: "5,000+", label: "Families served" },
        { value: "50+", label: "Services available" },
        { value: "100%", label: "Spanish & English service" },
      ],
    },
    stats: [
      { value: "10+", label: "Years of experience" },
      { value: "5,000+", label: "Clients served" },
      { value: "100%", label: "Bilingual service" },
      { value: "3", label: "Office locations" }
    ],
    whyUs: {
      eyebrow: "Why choose us?",
      heading: { pre: "Not just paperwork,", accent: "done right." },
      description:
        "Notary and apostilles, tax preparation and business filings, all handled correctly the first time, with a clear price before we start and a stamped record that it's done. Our team works primarily in Spanish, but we gladly assist English-speaking clients with these services.",
      items: [
        "Notarizations, apostilles and document legalization, done right",
        "Tax preparation with no errors that bring an IRS letter later",
        "Business filings in one place: LLC, EIN and corporate documents",
        "An exact price before we start, and proof in hand that it's done",
      ],
      imageAlt: "David Takamura, certified notary public",
    },
    cta: {
      eyebrow: "Resolving your pathway to success",
      heading: "Ready to resolve your tax situation?",
      subheading: "Schedule a free consultation and discover how we can help with your tax, notary, and business needs.",
      button: "Book free appointment",
      href: "/en/contact",
      phone: "(702) 640-0088",
      address: "235 N Eastern Ave. Suite 130, Las Vegas, NV. 89101",
      hours: "Mon–Sat 9AM–9PM · Sun 10AM–5PM"
    }
  }
}[lang];

---

<main>
  <!-- HERO SLIDER -->
  <Hero lang={lang} />

  <!-- ─── COMMUNITY & STATS ─────────────────────────────────────────── -->
  <section class="bg-white py-4" aria-labelledby="community-heading">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row items-stretch">

        <!-- LEFT: copy panel -->
        <div
          class="flex-1 py-20 lg:py-24 lg:pr-16 xl:pr-24 flex flex-col justify-center border-b lg:border-b-0 "
          data-reveal
        >
          <!-- Label -->
          <div class="flex items-center gap-3 mb-6">
            <span class="h-px w-10 bg-brand-light shrink-0" aria-hidden="true"></span>
            <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
              {t.community.label}
            </span>
          </div>

          <!-- Heading -->
          <h2
            id="community-heading"
            class="font-display text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-neutral-grey leading-[1.1] mb-6"
          >
            {t.community.heading.pre}{' '}
            <em class="not-italic text-brand-light">{t.community.heading.accent}</em>
            {t.community.heading.post && <>{' '}{t.community.heading.post}</>}
          </h2>

          <!-- Description -->
          <p class="text-neutral-grey leading-relaxed mb-8 max-w-[480px]">
            {t.community.description}
          </p>

          <!-- CTA -->
          <a
            href={t.community.ctaHref}
            class="self-start inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5 text-sm font-semibold text-white hover:bg-brand-light transition-colors focus-visible:outline-2 focus-visible:outline-brand-dark mb-10"
          >
            {t.community.cta}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>

          <!-- Trust indicators -->
          <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
            {t.community.trust.map(item => (
              <li class="flex items-center gap-1.5 text-xs font-medium text-neutral-grey">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" class="size-3.5 text-brand-light shrink-0" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.416 3.376a.75.75 0 0 1 .208 1.04l-5 7.5a.75.75 0 0 1-1.154.114l-3-3a.75.75 0 0 1 1.06-1.06l2.353 2.353 4.493-6.74a.75.75 0 0 1 1.04-.207Z" clip-rule="evenodd" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- RIGHT: stats cards -->
        <div class="lg:w-[45%] flex-shrink-0 flex items-center p-8 lg:p-12">
          <dl class="grid grid-cols-2 gap-4 w-full">
            {t.community.stats.map((stat, i) => (
              <div
                class="group flex flex-col items-start justify-between bg-white rounded-2xl border border-background-muted p-6 lg:p-7 shadow-sm hover:shadow-md transition-shadow duration-300 cursor-default"
                data-reveal
                data-reveal-delay={String(i)}
              >
                <dt class="font-display text-4xl lg:text-5xl font-bold text-neutral-grey leading-none group-hover:text-brand-light transition-colors duration-300">
                  {stat.value}
                </dt>
                <dd class="text-xs sm:text-sm text-neutral-grey mt-4 leading-snug">
                  {stat.label}
                </dd>
              </div>
            ))}
          </dl>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── SERVICES ──────────────────────────────────────────────────── -->
  <ServicesSection lang={lang} />


  <!-- ─── WHY US ────────────────────────────────────────────────────── -->
  <section class="py-32 bg-white" aria-labelledby="whyus-heading">
    <div class="container-custom">
      <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-center">

        <!-- Left: imagen vertical -->
        <div class="w-full max-w-xs mx-auto lg:mx-0 lg:w-[34%] lg:shrink-0" data-reveal>
          <img
            src="/assets/images/david_takamura_notario.jpg"
            alt={t.whyUs.imageAlt}
            width="795"
            height="1193"
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-2xl shadow-xl"
          />
        </div>

        <!-- Right: texto + checklist -->
        <div class="flex-1 text-center lg:text-left" data-reveal data-reveal-delay="1">
          <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
            {t.whyUs.eyebrow}
          </span>
          <h2
            id="whyus-heading"
            class="font-display text-4xl md:text-5xl font-bold text-neutral-dark mt-4 mb-6 leading-tight"
          >
            {t.whyUs.heading.pre}
            <span class="text-brand-light block">{t.whyUs.heading.accent}</span>
          </h2>
          <p class="text-neutral-grey leading-relaxed mb-8 max-w-md mx-auto lg:mx-0">
            {t.whyUs.description}
          </p>
          <ul class="space-y-4 text-left" role="list">
            {t.whyUs.items.map(item => (
              <li class="flex items-start gap-3">
                <span
                  class="shrink-0 mt-0.5 size-6 rounded-full bg-brand-light
                         flex items-center justify-center"
                  aria-hidden="true"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5 text-white">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                </span>
                <span class="text-base text-neutral-dark font-medium leading-snug">{item}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>



  <!-- ─── CTA BANNER ────────────────────────────────────────────────── -->
  <section class="bg-midnight" aria-labelledby="cta-heading">

    <!-- Main CTA -->
    <div class="container-custom py-20 lg:py-28 text-center" data-reveal>

      <!-- Eyebrow with decorative lines -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <span class="h-px w-12 bg-brand-light/60" aria-hidden="true"></span>
        <span class="text-xs font-bold tracking-widest text-brand-light/80 uppercase">
          {t.cta.eyebrow}
        </span>
        <span class="h-px w-12 bg-brand-light/60" aria-hidden="true"></span>
      </div>

      <h2
        id="cta-heading"
        class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white
               mb-6 leading-tight max-w-3xl mx-auto"
      >
        {t.cta.heading}
      </h2>

      <p class="text-white/60 mb-10 max-w-xl mx-auto leading-relaxed">
        {t.cta.subheading}
      </p>

      <a
        href={t.cta.href}
        class="inline-flex items-center gap-2 rounded-full bg-brand-light
               px-8 py-4 text-base font-semibold text-white
               hover:bg-brand-dark transition-colors shadow-lg
               focus-visible:outline-2 focus-visible:outline-brand-light"
      >
        {t.cta.button}
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </section>
</main>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
