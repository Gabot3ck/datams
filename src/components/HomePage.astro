---
import CommunitySection from './CommunitySection.astro';
import Hero from './Hero.astro';
import ServicesSection from './ServicesSection.astro';
import WhyUsSection from './WhyUsSection.astro';
import TestimonialsSection from './TestimonialsSection.astro';
import FaqSection from './FaqSection.astro';


interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

const t = {
  es: {
    stats: [
      { value: "10+", label: "Años de experiencia" },
      { value: "5,000+", label: "Clientes atendidos" },
      { value: "100%", label: "Servicio en español" },
      { value: "3", label: "Oficinas disponibles" }
    ],
    cta: {
      eyebrow: "Da el primer paso",
      heading: "¿Listo para resolver tu situación fiscal?",
      subheading: "Agenda una consulta sin costo y descubre cómo podemos ayudarte con tus trámites fiscales, de notary public y corporativos.",
      button: "Agendar cita gratis",
      href: "/contacto",
      imageAlt: "Asesor de Data's & Multiservices atendiendo a un cliente",
      phone: "(702) 640-0088",
      address: "235 N Eastern Ave. Suite 130, Las Vegas, NV. 89101",
      hours: "Lun–Sáb 9AM–9PM · Dom 10AM–5PM"
    },
    office: {
      kicker: "Taxes, notary public e inmigración, en un mismo lugar",
      heading: { pre: "Conoce", accent: "nuestra oficina", post: "en Las Vegas" },
      description:
        "Ven a nuestra oficina en Las Vegas y resuelve en una sola visita lo que normalmente te tomaría ir a tres lugares distintos.",
      cta: "Cómo llegar",
      ctaHref: "https://www.google.com/maps/dir/?api=1&destination=235%20N%20Eastern%20Ave%20Suite%20130%2C%20Las%20Vegas%2C%20NV%2089101",
      images: [
        { src: "/assets/images/test/thumb_servicios_90c45b98c0.jpg", alt: "Atención a un cliente en la oficina" },
        { src: "/assets/images/test/thumb_empresas_4b46959dd7.avif", alt: "Asesoría a un negocio local" },
        { src: "/assets/images/test/thumb_servicios_90c45b98c0.jpg", alt: "Recepción de la oficina en Las Vegas" },
      ],
      videoPoster: "/assets/images/test/thumb_empresas_4b46959dd7.avif",
      videoAlt: "Video: recorrido por nuestra oficina",
      videoTime: "03:05 / 05:10",
    },
    faq: [
      {
        q: "¿Son ustedes abogados de inmigración?",
        a: "No. No somos un despacho de abogados ni damos asesoría legal. Te ayudamos a completar formularios, reunir documentos y dar seguimiento a tu trámite. Si tu caso necesita representación legal, te decimos con honestidad cuándo es momento de acudir a un abogado con licencia.",
      },
      {
        q: "¿Puedo resolver varios trámites en una sola visita?",
        a: "Sí. Muchos de nuestros clientes aprovechan la visita para resolver taxes, notary public o inmigración el mismo día, sin tener que ir a tres lugares distintos.",
      },
      {
        q: "¿Necesito agendar una cita o puedo llegar directamente?",
        a: "Puedes agendar por WhatsApp, teléfono o en persona. Agendar te garantiza que no esperes, pero también recibimos visitas sin cita según disponibilidad.",
      },
      {
        q: "¿Cuánto cuestan sus servicios?",
        a: "El precio depende de tu trámite específico. Te lo decimos claro antes de empezar, nunca 'vamos viendo según avance'.",
      },
      {
        q: "¿Atienden en la tarde o los fines de semana?",
        a: "Sí, atendemos en la tarde y los fines de semana. Nuestros horarios son de lunes a sábado de 09:00 AM a 09:00 PM y los domingos de 10:00 AM a 5:00 PM.",
      },
      {
        q: "¿Qué documentos necesito llevar?",
        a: "Depende del trámite. En la página de cada servicio tienes la lista exacta o escríbenos antes de tu cita y te confirmamos qué traer.",
      },
    ]
  },
  en: {
    stats: [
      { value: "10+", label: "Years of experience" },
      { value: "5,000+", label: "Clients served" },
      { value: "100%", label: "Bilingual service" },
      { value: "3", label: "Office locations" }
    ],
    cta: {
      eyebrow: "Take the first step",
      heading: "Ready to resolve your tax situation?",
      subheading: "Schedule a free consultation and discover how we can help with your tax, notary, and business needs.",
      button: "Book free appointment",
      href: "/en/contact",
      imageAlt: "A Data's & Multiservices advisor helping a client",
      phone: "(702) 640-0088",
      address: "235 N Eastern Ave. Suite 130, Las Vegas, NV. 89101",
      hours: "Mon–Sat 9AM–9PM · Sun 10AM–5PM"
    },
    office: {
      kicker: "Taxes, notary, and immigration help, all in one place",
      heading: { pre: "Visit", accent: "Our Office", post: "in Las Vegas" },
      description:
        "Visit our Las Vegas office and handle in one trip what would normally mean three different stops.",
      cta: "Get Directions",
      ctaHref: "https://www.google.com/maps/dir/?api=1&destination=235%20N%20Eastern%20Ave%20Suite%20130%2C%20Las%20Vegas%2C%20NV%2089101",
      images: [
        { src: "/assets/images/test/thumb_servicios_90c45b98c0.jpg", alt: "Helping a client at the office" },
        { src: "/assets/images/test/thumb_empresas_4b46959dd7.avif", alt: "Advising a local business" },
        { src: "/assets/images/test/thumb_servicios_90c45b98c0.jpg", alt: "Front desk of the Las Vegas office" },
      ],
      videoPoster: "/assets/images/test/thumb_empresas_4b46959dd7.avif",
      videoAlt: "Video: a tour of our office",
      videoTime: "03:05 / 05:10",
    },
    faq: [
      {
        q: "Are you immigration attorneys?",
        a: "No. We're not a law firm and we don't give legal advice. We help you complete forms, gather documents, and follow up on your case. If your case needs legal representation, we'll tell you honestly when it's time to see a licensed attorney.",
      },
      {
        q: "Can I handle several things in one visit?",
        a: "Yes. Many of our clients use one visit to take care of taxes, notary, or immigration paperwork the same day, without going to three different places.",
      },
      {
        q: "Do I need to make an appointment, or can I just come in?",
        a: "You can book by WhatsApp, phone, or in person. Booking guarantees you won't wait, but we also take walk-ins based on availability.",
      },
      {
        q: "How much do your services cost?",
        a: "The price depends on your specific case. We tell you clearly before we start, never 'we'll see as we go.'",
      },
      {
        q: "Are you open in the evening or on weekends?",
        a: "Yes, we are open in the afternoon and on weekends. Our hours are Monday through Saturday from 9:00 AM to 9:00 PM and Sundays from 10:00 AM to 5:00 PM.",
      },
      {
        q: "What documents do I need to bring?",
        a: "It depends on the service. Each service page has the exact list, or message us before your appointment and we'll confirm what to bring.",
      },
    ]
  }
}[lang];

---

<main>
  <!-- HERO SLIDER -->
  <Hero lang={lang} />

  <!-- ─── COMMUNITY & STATS ─────────────────────────────────────────── -->
  <CommunitySection lang={lang} />

  <!-- ─── SERVICES ──────────────────────────────────────────────────── -->
  <ServicesSection lang={lang} />


  <!-- ─── WHY US ────────────────────────────────────────────────────── -->
  <WhyUsSection lang={lang} />

  <!-- ─── TESTIMONIOS ───────────────────────────────────────────────── -->
  <TestimonialsSection lang={lang} />


  <!-- ─── OFICINA — GALERÍA IMÁGENES + VIDEO ────────────────────────── -->
  <section class="py-24 bg-background-light" aria-labelledby="office-heading">
    <div class="container-custom">

      <!-- Cabecera -->
      <div class="text-center mb-12" data-reveal>
        <span class="text-xs font-bold tracking-widest text-brand-light uppercase">
          {t.office.kicker}
        </span>
        <h2
          id="office-heading"
          class="font-display text-4xl md:text-5xl font-bold text-neutral-dark mt-4 mb-5 leading-tight text-balance"
        >
          {t.office.heading.pre}{' '}
          <span class="text-brand">{t.office.heading.accent}</span>{' '}
          {t.office.heading.post}
        </h2>
        <p class="text-neutral-grey text-lg leading-relaxed max-w-xl mx-auto text-pretty">
          {t.office.description}
        </p>
      </div>

      <!-- Medios: 2 imágenes apiladas · 1 imagen vertical · video -->
      <div
        class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-[1fr_1.1fr_2fr] lg:grid-rows-1 lg:h-[460px]"
        data-reveal
        data-reveal-delay="1"
      >
        <!-- Columna 1: dos imágenes apiladas -->
        <div class="flex flex-col gap-4 lg:h-full">
          {t.office.images.slice(0, 2).map(img => (
            <img
              src={img.src}
              alt={img.alt}
              loading="lazy"
              decoding="async"
              class="w-full flex-1 min-h-0 aspect-[4/3] lg:aspect-auto object-cover rounded-xl"
            />
          ))}
        </div>

        <!-- Columna 2: imagen vertical -->
        <img
          src={t.office.images[2].src}
          alt={t.office.images[2].alt}
          loading="lazy"
          decoding="async"
          class="w-full aspect-[3/4] lg:aspect-auto lg:h-full object-cover rounded-xl"
        />

        <!-- Columna 3: video (placeholder de imagen + overlay decorativo de controles) -->
        <figure class="relative sm:col-span-2 lg:col-span-1 lg:h-full overflow-hidden rounded-xl">
          <img
            src={t.office.videoPoster}
            alt={t.office.videoAlt}
            loading="lazy"
            decoding="async"
            class="w-full aspect-video lg:aspect-auto lg:h-full object-cover"
          />
          {/*
            Video real: reemplazar el <img> de arriba por
            <video class="w-full lg:h-full object-cover" controls preload="metadata"
                   poster={t.office.videoPoster} aria-label={t.office.videoAlt}>
              <source src="/assets/video/oficina.mp4" type="video/mp4" />
            </video>
            y eliminar el overlay decorativo de abajo.
          */}
          <div
            class="pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-3
                   bg-gradient-to-t from-black/60 to-transparent px-4 pb-4 pt-10 text-white"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5 shrink-0">
              <path d="M6 4.75A.75.75 0 0 1 6.75 4h1.5a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1-.75-.75V4.75ZM11 4.75A.75.75 0 0 1 11.75 4h1.5a.75.75 0 0 1 .75.75v10.5a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1-.75-.75V4.75Z" />
            </svg>
            <span class="text-xs font-medium tabular-nums shrink-0">{t.office.videoTime}</span>
            <span class="relative h-1 flex-1 rounded-full bg-white/30">
              <span class="absolute inset-y-0 left-0 w-[60%] rounded-full bg-brand-light"></span>
            </span>
          </div>
        </figure>

      </div>

      <!-- CTA: cómo llegar -->
      <div class="mt-12 text-center" data-reveal>
        <a
          href={t.office.ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-brand px-7 py-3.5
                 text-sm font-semibold text-white transition-colors hover:bg-brand-light
                 focus-visible:outline-2 focus-visible:outline-brand-dark"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
            <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" />
          </svg>
          {t.office.cta}
        </a>
      </div>
    </div>
  </section>

  <!-- ─── FAQ ──────────────────────────────────────────────────────── -->
  <FaqSection
    lang={lang}
    faqs={t.faq}
    image={{
      src: "/assets/images/david_takamura_notary_public.jpg",
      alt: lang === 'es'
        ? "David Takamura, Notary Public certificado"
        : "David Takamura, certified notary public",
    }}
  />

  <!-- ─── CTA ──────────────────────────────────────────────────────── -->
  <section class="bg-background-light py-16 lg:py-24" aria-labelledby="cta-heading">
    <div class="container-custom">
      <div class="grid overflow-hidden rounded-[2.5rem] bg-brand shadow-xl lg:grid-cols-2" data-reveal>

        <!-- Imagen (placeholder — reemplazar por la definitiva) -->
        <div class="relative min-h-[200px] lg:min-h-0">
          <img
            src="/assets/images/contacta-datamultiservices.jpg"
            alt={t.cta.imageAlt}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>

        
        <!-- Texto + botón -->
        <div class="flex flex-col justify-center p-8 sm:p-10 lg:px-14 lg:py-12">
          <span class="text-xs font-bold uppercase tracking-widest text-white/60">
            {t.cta.eyebrow}
          </span>
          <h2
            id="cta-heading"
            class="font-display mt-2 mb-3 text-2xl font-bold leading-tight text-white text-balance md:text-3xl lg:text-4xl"
          >
            {t.cta.heading}
          </h2>
          <p class="max-w-md text-sm leading-relaxed text-white/80 lg:text-base">
            {t.cta.subheading}
          </p>
          <a
            href={t.cta.href}
            class="group mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-white
                   px-7 py-3.5 text-sm font-semibold text-brand shadow-lg
                   transition duration-300 hover:text-brand-dark hover:shadow-xl
                   focus-visible:outline-2 focus-visible:outline-white"
          >
            <span class="relative">
              {t.cta.button}
              <span
                class="absolute inset-x-0 -bottom-1 h-0.5 origin-left scale-x-0 bg-current
                       transition-transform duration-300 group-hover:scale-x-100 motion-reduce:transition-none"
                aria-hidden="true"
              ></span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5" aria-hidden="true">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>

        

      </div>
    </div>
  </section>
</main>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
