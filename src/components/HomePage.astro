---
import Hero from './Hero.astro';
import CommunitySection from './CommunitySection.astro';
import ServicesSection from './ServicesSection.astro';
import WhyUsSection from './WhyUsSection.astro';
import TestimonialsSection from './TestimonialsSection.astro';
import OfficeSection from './OfficeSection.astro';
import FaqSection from './FaqSection.astro';
import CtaSection from './CtaSection.astro';

interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

// FaqSection es un componente genérico (compartido con páginas de servicio): su contenido vive acá y se le pasa por props.
const faq = {
  es: [
      {
        q: "¿Son ustedes abogados de inmigración?",
        a: "No. No somos abogados en el estado de Nevada. No estamos autorizados para brindar asesoramiento legal ni representación legal. No podemos aceptar honorarios por brindar asesoramiento legal o representación legal. Te ayudamos a completar formularios, reunir documentos y dar seguimiento a tu trámite. Si tu caso necesita representación legal, te decimos con honestidad cuándo es momento de acudir a un abogado con licencia.",
      },
      {
        q: "¿Puedo resolver varios trámites en una sola visita?",
        a: "Sí. Muchos de nuestros clientes aprovechan la visita para resolver taxes, notary public o inmigración el mismo día, sin tener que ir a tres lugares distintos.",
      },
      {
        q: "¿Necesito agendar una cita o puedo llegar directamente?",
        a: "No necesitas agendar cita ya que atendemos por orden de llegada. Puedes venir el día que mejor te acomode según tu horario de trabajo, y te atendemos en el orden en que llegas, sin que nadie se adelante. En temporada de taxes (enero a abril) te recomendamos llegar temprano para esperar menos.",
      },
      {
        q: "¿Cuánto cuestan sus servicios?",
        a: "Cada trámite tiene su propio precio según lo que necesites, y siempre te lo decimos antes de empezar, sin sorpresas ni cobros de último momento.",
      },
      {
        q: "¿Atienden todo el año o solo en temporada de taxes?",
        a: "Atendemos todo el año, solo cerramos el 1 de enero. El horario cambia según la temporada:",
        list: [
          { label: "Temporada de taxes (2 de enero–15 de abril):", text: "lunes a sábado de 9:00 AM a 10:00 PM." },
          { label: "Resto del año (16 de abril–31 de diciembre):", text: "lunes a viernes de 10:00 AM a 7:00 PM, sábados de 10:00 AM a 2:00 PM." },
        ],
      },
      {
        q: "¿Qué documentos necesito llevar?",
        a: "Depende del trámite. En la página de cada servicio tienes la lista exacta o escríbenos antes de tu cita y te confirmamos qué traer.",
      },
    ],
  en: [
      {
        q: "Are you immigration attorneys?",
        a: "No. We are not attorneys licensed to practice law in the State of Nevada. We are not authorized to give legal advice or provide legal representation, and we may not accept fees for legal advice or legal representation. We help you complete forms, gather documents, and follow up on your case. If your case needs legal representation, we'll tell you honestly when it's time to see a licensed attorney.",
      },
      {
        q: "Can I handle several things in one visit?",
        a: "Yes. Many of our clients use one visit to take care of taxes, notary, or immigration paperwork the same day, without going to three different places.",
      },
      {
        q: "Do I need to make an appointment, or can I just come in?",
        a: "No appointment needed — we serve clients on a first-come, first-served basis. Come in whichever day works best with your work schedule, and you'll be helped in the order you arrive, with no one cutting ahead of you. During tax season (January to April), we recommend coming early to keep your wait short.",
      },
      {
        q: "How much do your services cost?",
        a: "Each service has its own price depending on what you need, and we always tell you before we start, with no surprises or last-minute charges.",
      },
      {
        q: "Are you open year-round or only during tax season?",
        a: "We're open year-round, only closed on January 1. Our hours change by season:",
        list: [
          { label: "Tax season (January 2–April 15):", text: "Monday through Saturday, 9:00 AM to 10:00 PM." },
          { label: "Rest of the year (April 16–December 31):", text: "Monday through Friday, 10:00 AM to 7:00 PM; Saturdays, 10:00 AM to 2:00 PM." },
        ],
      },
      {
        q: "What documents do I need to bring?",
        a: "It depends on the service. Each service page has the exact list, or message us before your appointment and we'll confirm what to bring.",
      },
    ],
}[lang];

const faqImage = {
  src: "/assets/images/david_takamura_notary_public.jpg",
  alt: lang === 'es'
    ? "David Takamura, Notary Public certificado"
    : "David Takamura, certified notary public",
};
---

<main>
  <!-- HERO SLIDER -->
  <Hero lang={lang} />

  <!-- ─── COMMUNITY & STATS ─────────────────────────────────────────── -->
  <CommunitySection lang={lang} />

  <!-- ─── SERVICES ──────────────────────────────────────────────────── -->
  <ServicesSection lang={lang} />

  <!-- ─── WHY US ────────────────────────────────────────────────────── -->
  <WhyUsSection lang={lang} />

  <!-- ─── TESTIMONIOS ───────────────────────────────────────────────── -->
  <TestimonialsSection lang={lang} />

  <!-- ─── OFICINA — GALERÍA IMÁGENES + VIDEO ────────────────────────── -->
  <OfficeSection lang={lang} />

  <!-- ─── FAQ ──────────────────────────────────────────────────────── -->
  <FaqSection
    lang={lang}
    faqs={faq}
    image={faqImage}
  />

  <!-- ─── CTA ──────────────────────────────────────────────────────── -->
  <CtaSection lang={lang} />
</main>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 }
  );

  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
</script>
