---
// Valores del equipo: 4 ítems con ícono de línea (stroke) en color de marca.
interface Props {
  lang: 'es' | 'en';
}
const { lang } = Astro.props;

// Trazos de 24×24 (stroke, sin relleno).
const icons = {
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/>',
  chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12Z"/><path d="M8.5 10.5h7M8.5 13.5h4.5"/>',
  doc: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/><path d="m9 14 2 2 4-4"/>',
  home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9v11h14V9"/><path d="M12 17.5s-3-1.8-3-3.8a1.6 1.6 0 0 1 3-.8 1.6 1.6 0 0 1 3 .8c0 2-3 3.8-3 3.8Z"/>',
};

const t = {
  es: {
    heading: 'Nuestros valores',
    values: [
      { icon: icons.eye, title: 'Transparencia', text: 'Te decimos el precio antes de empezar y te explicamos cada documento que firmas.' },
      { icon: icons.chat, title: 'En tu idioma', text: 'Te atendemos en español, con palabras claras y sin letra pequeña.' },
      { icon: icons.doc, title: 'Responsabilidad', text: 'Revisamos dos veces y te entregamos un comprobante de que todo quedó bien hecho.' },
      { icon: icons.home, title: 'Cercanía', text: 'Somos parte de la comunidad hispana de Las Vegas; aquí te conocemos por tu nombre.' },
    ],
  },
  en: {
    heading: 'Our values',
    values: [
      { icon: icons.eye, title: 'Transparency', text: 'We tell you the price before we start and explain every document you sign.' },
      { icon: icons.chat, title: 'In your language', text: 'We serve you in Spanish, in plain words, with no fine print.' },
      { icon: icons.doc, title: 'Responsibility', text: 'We double-check and give you proof that everything was done right.' },
      { icon: icons.home, title: 'Community', text: 'We are part of the Las Vegas Hispanic community; here we know you by name.' },
    ],
  },
}[lang];
---

<section aria-labelledby="values-heading" class="bg-cream py-section">
  <div class="container-custom">
    <h2
      id="values-heading"
      class="font-display text-fluid-2xl md:text-fluid-3xl lg:text-fluid-4xl font-bold text-neutral-grey leading-[1.1] text-center mb-fluid-lg"
    >
      {t.heading}
    </h2>
    <ul class="grid gap-fluid-md sm:grid-cols-2 lg:grid-cols-4" role="list">
      {t.values.map((v) => (
        <li class="min-w-0 text-center flex flex-col items-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="size-12 text-brand mb-fluid-sm"
            aria-hidden="true"
            set:html={v.icon}
          />
          <h3 class="font-display text-fluid-lg font-bold text-neutral-dark mb-1">{v.title}</h3>
          <p class="text-fluid-card text-neutral-grey leading-relaxed max-w-[280px]">{v.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
