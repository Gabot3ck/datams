---
import HomePage from '@components/HomePage.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
	title="Las Vegas Tax Preparation | Data's & Multiservices"
	description="Las Vegas tax preparation in English and Spanish: personal and business taxes, IRS letter help, ITIN/EIN and Notary Public. Walk in at 235 N Eastern Ave."
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "LocalBusiness",
		"name": "Tax & Notary Public",
		"description": "Tax, notary, and business services for the Hispanic community in the U.S.",
		"url": Astro.url.href,
		"inLanguage": "en-US",
		"serviceArea": {
			"@type": "Country",
			"name": "United States"
		}
	}}
>
	<HomePage lang="en" />
</BaseLayout>
