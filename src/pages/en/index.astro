---
import HomePage from '@components/HomePage.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
	title="Tax & Notary | Tax and notary services for the Hispanic community in the U.S."
	description="Professional tax preparation, notary, and business services for the Hispanic community in the United States. Fully bilingual service in Spanish and English."
	image="/assets/og-image.png"
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "LocalBusiness",
		"name": "Tax & Notary",
		"description": "Tax, notary, and business services for the Hispanic community in the U.S.",
		"url": Astro.url.href,
		"inLanguage": "en-US",
		"serviceArea": {
			"@type": "Country",
			"name": "United States"
		}
	}}
>
	<HomePage lang="en" />
</BaseLayout>
