---
import HomePage from '../components/HomePage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Taxes en Las Vegas y Notary Public | Data's & Multiservices"
	description="Taxes en Las Vegas con atención en español: declaración personal y de negocio, cartas del IRS, ITIN/EIN y Notary Public. Sin cita, ven a 235 N Eastern Ave."
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "LocalBusiness",
		"name": "Tax & Notary Public",
		"description": "Servicios de impuestos, notary public y servicios corporativos para la comunidad hispana en EE.UU.",
		"url": Astro.url.href,
		"inLanguage": "es-US",
		"serviceArea": {
			"@type": "Country",
			"name": "United States"
		}
	}}
>
	<HomePage lang="es" />
</BaseLayout>
