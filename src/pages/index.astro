---
import HomePage from '../components/HomePage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Tax & Notary Public | Impuestos y trámites de notary public para la comunidad hispana en EE.UU."
	description="Ofrecemos servicios profesionales de preparación de taxes, notary public y servicios corporativos para la comunidad hispana en Estados Unidos. Atención 100% en español."
	image="/assets/og-image.png"
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "LocalBusiness",
		"name": "Tax & Notary Public",
		"description": "Servicios de impuestos, notary public y servicios corporativos para la comunidad hispana en EE.UU.",
		"url": Astro.url.href,
		"inLanguage": "es-US",
		"serviceArea": {
			"@type": "Country",
			"name": "United States"
		}
	}}
>
	<HomePage lang="es" />
</BaseLayout>
